    }
    
    /* 7. Fix Single Chart Container */
    #singleChartContainer {
        position: relative;
        overflow: visible !important;
        padding-top: 20px;
    }
    
    /* 8. Responsive Fixes */
    @@media (max-width: 768px) {
        .apexcharts-toolbar {
            top: -5px !important;
            right: 0px !important;
        }
        
        .admin-card-body {
            padding: 25px 20px 15px 20px !important;
        }
        
        #overviewCharts .admin-card-body {

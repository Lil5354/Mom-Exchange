        }
    }
</style>

@section scripts {
    <!-- ApexCharts Library -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <script>
        // Ocean Blue Theme Colors
        const chartColors = {
            primary: '#1e3a8a',
            secondary: '#3b82f6',
            accent: '#0ea5e9',
            success: '#10b981',
            warning: '#f59e0b',
            danger: '#ef4444',
            info: '#06b6d4',
            gradient: ['#0ea5e9', '#3b82f6', '#1e3a8a']
        };

        // Calculate monthly data
        const monthNames = ['Tháng 5', 'Tháng 6', 'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10'];
        const totalUsers = @Model.TotalUsers;
        const newUsersThisMonth = @Model.NewUsersThisMonth;
        
        // Generate growth data (simulate previous months)
        const userGrowthData = [];
        const newUsersData = [];
        for (let i = 0; i < 5; i++) {
            const prevTotal = Math.max(0, totalUsers - (5 - i) * Math.ceil(newUsersThisMonth * 1.2));
            userGrowthData.push(prevTotal);
            newUsersData.push(Math.ceil(newUsersThisMonth * (0.8 + Math.random() * 0.4)));
        }
        userGrowthData.push(totalUsers);
        newUsersData.push(newUsersThisMonth);

        // Sample Data
        const chartData = {
            userGrowth: {
                months: monthNames,
                users: userGrowthData,
                newUsers: newUsersData
            },
            roleDistribution: {
                labels: ['Quản trị viên', 'Mẹ bỉm', 'Nhãn hàng'],
                series: [@Model.AdminUsers, @Model.MomUsers]
            },
            monthlyActivity: {
                months: [],
                newUsers: [],
                posts: [],
                interactions: []
            },
            accountStatus: {
                active: @Model.ActiveUsers,
                inactive: @(Model.TotalUsers - Model.ActiveUsers)
            },
            postTrends: {
                months: [],
                posts: []
            },
            regionStats: {
                regions: [],
                users: []
            }
        };

        // Store chart instances
        var charts = {};

        // Load chart data from API
        async function loadChartDataFromAPI() {
            try {
                // Load all chart data from API
                const [monthlyActivityResponse, regionResponse, postTrendsResponse] = await Promise.all([
                    fetch('/Admin/Admin/GetChartData?chartType=monthlyActivity'),
                    fetch('/Admin/Admin/GetChartData?chartType=regionStats'),
                    fetch('/Admin/Admin/GetChartData?chartType=postTrends')
                ]);
                
                // Load monthly activity data
                if (monthlyActivityResponse.ok) {
                    const result = await monthlyActivityResponse.json();
                    if (result.success && result.data) {
                        chartData.monthlyActivity.months = result.data.months;
                        chartData.monthlyActivity.newUsers = result.data.newUsers;
                        chartData.monthlyActivity.posts = result.data.posts;
                        chartData.monthlyActivity.interactions = result.data.interactions;
                    }
                }
                
                // Load post trends data (actual posts from DB)
                if (postTrendsResponse.ok) {
                    const result = await postTrendsResponse.json();
                    if (result.success && result.data) {
                        chartData.postTrends.months = result.data.months;
                        chartData.postTrends.posts = result.data.posts;
                    }
                }
                
                // Load region stats from API
                if (regionResponse.ok) {
                    const result = await regionResponse.json();
                    if (result.success && result.data) {
                        chartData.regionStats.regions = result.data.regions;
                        chartData.regionStats.users = result.data.users;
                    }
                }
            } catch (error) {
                console.error('Error loading chart data:', error);
            }
        }

        // Chart configurations
        function createUserGrowthChart(elementId) {
            var options = {
                series: [{
                    name: 'Tổng người dùng',
                    data: chartData.userGrowth.users
                }, {
                    name: 'Người dùng mới',
                    data: chartData.userGrowth.newUsers
                }],
                chart: {
                    height: 350,
                    type: 'line',
                    animations: {
                        enabled: true,
                        easing: 'easeinout',
                        speed: 800,
                        animateGradually: {
                            enabled: true,
                            delay: 150
                        },
                        dynamicAnimation: {
                            enabled: true,
                            speed: 350
                        }
                    },
                    toolbar: {
                        show: true,
                        offsetY: -5,
                        offsetX: -5,
                        tools: {
                            download: true,
                            selection: false,
                            zoom: true,
                            zoomin: true,
                            zoomout: true,
                            pan: false,
                            reset: true
                        },
                        export: {
                            csv: {
                                filename: 'user-growth-data'
                            },
                            svg: {
                                filename: 'user-growth-chart'
                            },
                            png: {
                                filename: 'user-growth-chart'
                            }
                        },
                        autoSelected: 'zoom'
                    },
                    zoom: {
                        enabled: true,
                        type: 'x',
                        autoScaleYaxis: true
                    }
                },
                colors: [chartColors.accent, chartColors.success],
                dataLabels: {
                    enabled: true,
                    style: {
                        fontSize: '12px',
                        fontWeight: 'bold'
                    }
                },
                stroke: {
                    curve: 'smooth',
                    width: 3
                },
                grid: {
                    borderColor: '#e7e7e7',
                    row: {
                        colors: ['#f3f3f3', 'transparent'],
                        opacity: 0.5
                    },
                    padding: {
                        top: 15,
                        right: 20,
                        bottom: 10,
                        left: 10
                    }
                },
                markers: {
                    size: 6,
                    hover: {
                        size: 9
                    }
                },
                xaxis: {
                    categories: chartData.userGrowth.months,
                    labels: {
                        style: {
                            fontSize: '12px',
                            fontWeight: 600
                        }
                    }
                },
                yaxis: {
                    title: {
                        text: 'Số lượng',
                        style: {
                            fontSize: '14px',
                            fontWeight: 700
                        }
                    }
                },
                legend: {
                    position: 'top',
                    horizontalAlign: 'right',
                    fontSize: '14px',
                    fontWeight: 600
                },
                tooltip: {
                    theme: 'light',
                    x: {
                        show: true
                    },
                    y: {
                        formatter: function(val) {
                            return val + " người dùng"
                        }
                    }
                }
            };

            var chart = new ApexCharts(document.querySelector("#" + elementId), options);
            chart.render();
            return chart;
        }

        function createRoleDistributionChart(elementId) {
            var options = {
                series: chartData.roleDistribution.series,
                chart: {
                    type: 'donut',
                    height: 350,
                    animations: {
                        enabled: true,
                        easing: 'easeinout',
                        speed: 800,
                        animateGradually: {
                            enabled: true,
                            delay: 150
                        }
                    }
                },
                labels: chartData.roleDistribution.labels,
                colors: [chartColors.danger, chartColors.warning, chartColors.info],
                plotOptions: {
                    pie: {
                        donut: {
                            size: '70%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Tổng',
                                    fontSize: '18px',
                                    fontWeight: 700,
                                    color: chartColors.primary,
                                    formatter: function (w) {
                                        return w.globals.seriesTotals.reduce((a, b) => a + b, 0)
                                    }
                                },
                                value: {
                                    fontSize: '24px',
                                    fontWeight: 700,
                                    color: chartColors.accent
                                }
                            }
                        }
                    }
                },
                dataLabels: {
                    enabled: true,
                    formatter: function (val, opts) {
                        return opts.w.config.series[opts.seriesIndex]
                    },
                    style: {
                        fontSize: '14px',
                        fontWeight: 'bold'
                    }
                },
                legend: {
                    position: 'bottom',
                    fontSize: '14px',
                    fontWeight: 600
                },
                tooltip: {
                    theme: 'light',
                    y: {
                        formatter: function(val) {
                            return val + " người"
                        }
                    }
                }
            };

            var chart = new ApexCharts(document.querySelector("#" + elementId), options);
            chart.render();
            return chart;
        }

        function createMonthlyActivityChart(elementId) {
            var options = {
                series: [{
                    name: 'Người dùng mới',
                    data: chartData.monthlyActivity.newUsers
                }, {
                    name: 'Bài đăng',
                    data: chartData.monthlyActivity.posts

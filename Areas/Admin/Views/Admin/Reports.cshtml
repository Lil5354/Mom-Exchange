        // Initialize all charts
        function initializeOverviewCharts() {
            if (charts.userGrowth) charts.userGrowth.destroy();
            if (charts.roleDistribution) charts.roleDistribution.destroy();
            if (charts.monthlyActivity) charts.monthlyActivity.destroy();
            if (charts.accountStatus) charts.accountStatus.destroy();

            charts.userGrowth = createUserGrowthChart('userGrowthChart');
            charts.roleDistribution = createRoleDistributionChart('roleDistributionChart');
            charts.monthlyActivity = createMonthlyActivityChart('monthlyActivityChart');
            charts.accountStatus = createAccountStatusChart('accountStatusChart');
        }

        // Handle chart type selection
        function showSelectedChart(chartType) {
            var overviewDiv = document.getElementById('overviewCharts');
            var singleDiv = document.getElementById('singleChartContainer');
            
            if (chartType === 'overview') {
                overviewDiv.style.display = 'block';
                singleDiv.style.display = 'none';
                initializeOverviewCharts();
            } else {
                overviewDiv.style.display = 'none';
                singleDiv.style.display = 'block';
                singleDiv.innerHTML = '<div id="selectedChart"></div>';
                
                // Destroy previous single chart if exists
                if (charts.selectedChart) {
                    charts.selectedChart.destroy();
                }
                
                // Create new chart based on selection
                switch(chartType) {
                    case 'userGrowth':
                        charts.selectedChart = createUserGrowthChart('selectedChart');
                        break;
                    case 'roleDistribution':
                        charts.selectedChart = createRoleDistributionChart('selectedChart');
                        break;
                    case 'monthlyActivity':
                        charts.selectedChart = createMonthlyActivityChart('selectedChart');
                        break;
                    case 'accountStatus':
                        charts.selectedChart = createAccountStatusChart('selectedChart');
                        break;
                    case 'postTrends':
                        charts.selectedChart = createPostTrendsChart('selectedChart');
                        break;
                    case 'regionStats':
                        charts.selectedChart = createRegionStatsChart('selectedChart');
                        break;
                }
            }
        }

        // Document ready
        $(document).ready(function() {
            // Load dynamic data from API first
            loadChartDataFromAPI().then(function() {
                // Initialize overview charts after data is loaded
                initializeOverviewCharts();
            });
            
            // Chart type selector
            $('#chartTypeSelector').on('change', function() {
                var selectedType = $(this).val();
                showSelectedChart(selectedType);
            });
            
            // Refresh reports
            $('#refreshReports').on('click', function() {
                var button = $(this);
                var originalText = button.html();
                
                button.html('<i class="fas fa-spinner fa-spin"></i> Đang tải...');
                button.prop('disabled', true);
                
                setTimeout(function() {
                    // Reinitialize charts based on current view
                    var selectedType = $('#chartTypeSelector').val();
                    showSelectedChart(selectedType);
                    
                    button.html(originalText);
                    button.prop('disabled', false);
                    
                    // Update timestamp
                    var now = new Date();
                    var timeString = now.toLocaleDateString('vi-VN') + ' ' + now.toLocaleTimeString('vi-VN');
                    $('#lastUpdateTime').text('Cập nhật lần cuối: ' + timeString);
                    
                    // Show success message
                    var alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert" style="margin-bottom: 20px;">' +
                        '<strong>Thành công!</strong> Báo cáo đã được làm mới!' +
                        '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="float: right; background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>' +
                        '</div>';
                    $('.admin-content').prepend(alertHtml);
                    setTimeout(function() { $('.alert').fadeOut(); }, 3000);
                }, 1500);
            });
        });
    </script>

@model B_M.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "Báo cáo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* Compact Stats for Reports */
    .compact-stats-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    .compact-stat-card {
        background: var(--white);
        padding: 16px;
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(30, 58, 138, 0.06);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(59, 130, 246, 0.08);
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
        overflow: hidden;
    }

    .compact-stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--accent-blue), var(--secondary-blue));
    }

    .compact-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(30, 58, 138, 0.12);
    }

    .compact-stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: white;
        flex-shrink: 0;
    }

    .compact-stat-content {
        flex: 1;
    }

    .compact-stat-number {
        font-size: 24px;
        font-weight: 800;
        background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
        margin-bottom: 4px;
    }

    .compact-stat-label {
        color: var(--text-light);
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    /* Compact Table */
    .compact-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
    }

    .compact-table-wrapper::-webkit-scrollbar {
        width: 6px;
    }

    .compact-table-wrapper::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .compact-table-wrapper::-webkit-scrollbar-thumb {
        background: var(--accent-blue);
        border-radius: 10px;
    }

    .compact-table {
        width: 100%;
        border-collapse: collapse;
    }

    .compact-table th,
    .compact-table td {
        padding: 10px 12px;
        text-align: left;
        border-bottom: 1px solid rgba(59, 130, 246, 0.08);
        font-size: 13px;
    }

    .compact-table th {
        background: linear-gradient(135deg, var(--pastel-blue), var(--light-blue));
        font-weight: 700;
        color: var(--text-dark);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .compact-table tr:hover {
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.02), rgba(59, 130, 246, 0.02));
    }

    .compact-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 11px;
        flex-shrink: 0;
    }

    .compact-user-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .compact-user-name {
        font-weight: 600;
        color: var(--text-dark);
        font-size: 12px;
    }
</style>

<!-- Compact Statistics Overview -->
<div class="compact-stats-grid">
    <div class="compact-stat-card">
        <div class="compact-stat-icon" style="background: linear-gradient(135deg, #3498db, #2980b9);">
            <i class="fas fa-users"></i>
        </div>
        <div class="compact-stat-content">
            <div class="compact-stat-number">@Model.TotalUsers</div>
            <div class="compact-stat-label">Tổng người dùng</div>
        </div>
    </div>
    <div class="compact-stat-card">
        <div class="compact-stat-icon" style="background: linear-gradient(135deg, #2ecc71, #27ae60);">
            <i class="fas fa-user-check"></i>
        </div>
        <div class="compact-stat-content">
            <div class="compact-stat-number">@Model.ActiveUsers</div>
            <div class="compact-stat-label">Hoạt động</div>
        </div>
    </div>
    <div class="compact-stat-card">
        <div class="compact-stat-icon" style="background: linear-gradient(135deg, #e74c3c, #c0392b);">
            <i class="fas fa-crown"></i>
        </div>
        <div class="compact-stat-content">
            <div class="compact-stat-number">@Model.AdminUsers</div>
            <div class="compact-stat-label">Quản trị viên</div>
        </div>
    </div>
    <div class="compact-stat-card">
        <div class="compact-stat-icon" style="background: linear-gradient(135deg, #f39c12, #e67e22);">
            <i class="fas fa-baby"></i>
        </div>
        <div class="compact-stat-content">
            <div class="compact-stat-number">@Model.MomUsers</div>
            <div class="compact-stat-label">Mẹ bỉm</div>
        </div>
    </div>
    <div class="compact-stat-card">
        <div class="compact-stat-icon" style="background: linear-gradient(135deg, #9b59b6, #8e44ad);">
            <i class="fas fa-store"></i>
        </div>
        
    </div>
    <div class="compact-stat-card">
        <div class="compact-stat-icon" style="background: linear-gradient(135deg, #1abc9c, #16a085);">
            <i class="fas fa-user-plus"></i>
        </div>
        <div class="compact-stat-content">
            <div class="compact-stat-number">@Model.NewUsersThisMonth</div>
            <div class="compact-stat-label">Mới tháng này</div>
        </div>
    </div>
</div>

<!-- Chart Type Selector -->
<div class="admin-card" style="margin-bottom: 25px;">
    <div class="admin-card-header">
        <h5><i class="fas fa-chart-bar"></i> Báo cáo thống kê</h5>
        <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
            <select id="chartTypeSelector" class="form-control" style="width: 250px; padding: 8px 16px;">
                <option value="overview">📊 Tổng quan</option>
                <option value="userGrowth">📈 Tăng trưởng người dùng</option>
                <option value="roleDistribution">🥧 Phân bố vai trò</option>
                <option value="monthlyActivity">📊 Hoạt động theo tháng</option>
                <option value="postTrends">📉 Xu hướng bài đăng</option>
                <option value="accountStatus">⚡ Trạng thái tài khoản</option>
                <option value="regionStats">🗺️ Thống kê khu vực</option>
            </select>
            <button id="refreshReports" class="btn-admin-secondary" style="padding: 8px 16px;">
                <i class="fas fa-sync-alt"></i> Làm mới
            </button>
            <span id="lastUpdateTime" style="color: #7f8c8d; font-size: 14px;">
                Cập nhật lần cuối: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>
    </div>
    <div class="admin-card-body">
        <!-- Single Chart Container (for selected chart) -->
        <div id="singleChartContainer" style="display: none; min-height: 400px;"></div>

        <!-- Multi-Chart Overview (shown by default) -->
        <div id="overviewCharts" style="display: block;">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 25px; margin-bottom: 25px;">
        <!-- User Growth Chart -->
                <div class="admin-card">
            <div class="admin-card-header">
                        <h6><i class="fas fa-chart-line"></i> Tăng trưởng người dùng (6 tháng)</h6>
            </div>
            <div class="admin-card-body">
                        <div id="userGrowthChart"></div>
            </div>
        </div>

                <!-- Role Distribution Chart -->
                <div class="admin-card">
            <div class="admin-card-header">
                        <h6><i class="fas fa-pie-chart"></i> Phân bố vai trò</h6>
            </div>
            <div class="admin-card-body">
                        <div id="roleDistributionChart"></div>
                        </div>
                    </div>
                    
                <!-- Monthly Activity Chart -->
                <div class="admin-card">
                    <div class="admin-card-header">
                        <h6><i class="fas fa-chart-bar"></i> Hoạt động hàng tháng</h6>
                    </div>
                    <div class="admin-card-body">
                        <div id="monthlyActivityChart"></div>
                        </div>
                    </div>
                    
                <!-- Account Status Chart -->
                <div class="admin-card">
                    <div class="admin-card-header">
                        <h6><i class="fas fa-power-off"></i> Trạng thái tài khoản</h6>
                    </div>
                    <div class="admin-card-body">
                        <div id="accountStatusChart"></div>
                    </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

<!-- Recent Users - Compact Version -->
@if (Model.RecentUsers != null && Model.RecentUsers.Any())
{
    <div class="admin-card">
        <div class="admin-card-header">
            <h6><i class="fas fa-user-clock"></i> Người dùng mới nhất</h6>
        </div>
        <div class="admin-card-body" style="padding: 0;">
            <div class="compact-table-wrapper">
                <table class="compact-table">
                    <thead>
                        <tr>
                            <th>Người dùng</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.RecentUsers)
                        {
                            <tr>
                                <td>
                                    <div class="compact-user-info">
                                        <div class="compact-avatar" style="background: linear-gradient(135deg, #0ea5e9, #3b82f6);">
                                            @(user.UserDetails?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                                        </div>
                                        <div>
                                            <div class="compact-user-name">@(user.UserDetails?.FullName ?? "Chưa cập nhật")</div>
                                            <div style="font-size: 10px; color: var(--text-light);">@(user.UserName ?? "N/A")</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="color: var(--text-light); font-size: 12px;">@user.Email</td>
                                <td>
                                    @{
                                        string roleName = "";
                                        string roleClass = "";
                                        switch (user.Role)
                                        {
                                            case 1:
                                                roleName = "Admin";
                                                roleClass = "badge-danger";
                                                break;
                                            case 2:
                                                roleName = "Mẹ bỉm";
                                                roleClass = "badge-warning";
                                                break;
                                            case 3:
                                                roleName = "Nhãn hàng";
                                                roleClass = "badge-info";
                                                break;
                                            default:
                                                roleName = "N/A";
                                                roleClass = "badge-secondary";
                                                break;
                                        }
                                    }
                                    <span class="badge @roleClass" style="font-size: 10px; padding: 3px 8px;">@roleName</span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge badge-success" style="font-size: 10px; padding: 3px 8px;">
                                            <i class="fas fa-check-circle"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger" style="font-size: 10px; padding: 3px 8px;">
                                            <i class="fas fa-ban"></i> Khóa
                                        </span>
                                    }
                                </td>
                                <td style="color: var(--text-light); font-size: 12px;">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<style>
    /* ===== FIX CHART OVERLAP ISSUES ===== */
    
    /* 1. Fix ApexCharts Toolbar Position */
    .apexcharts-toolbar {
        z-index: 100 !important;
        top: 0px !important;
        right: 5px !important;
    }
    
    .apexcharts-menu {
        z-index: 1000 !important;
        background: white !important;
        border: 1px solid rgba(59, 130, 246, 0.2) !important;
        border-radius: 8px !important;
        box-shadow: 0 8px 32px rgba(30, 58, 138, 0.2) !important;
    }
    
    .apexcharts-menu-item {
        padding: 10px 20px !important;
        font-size: 14px !important;
        color: #1e3a8a !important;
        transition: all 0.2s ease !important;
    }
    
    .apexcharts-menu-item:hover {
        background: rgba(14, 165, 233, 0.1) !important;
        color: #0ea5e9 !important;
    }
    
    /* 2. Fix Chart Containers - Cho phép toolbar hiển thị bên ngoài */
    .admin-card {
        position: relative;
        z-index: auto;
        overflow: visible !important;
    }
    
    .admin-card-body {
        position: relative;
        z-index: auto;
        overflow: visible !important;
        padding: 30px 30px 20px 30px;
    }
    
    /* 3. Fix Overview Charts Grid */
    #overviewCharts {
        position: relative;
        z-index: auto;
    }
    
    #overviewCharts .admin-card {
        overflow: visible !important;
    }
    
    #overviewCharts .admin-card-body {
        min-height: 400px;
        overflow: visible !important;
        padding-top: 35px;
    }
    
    /* 4. Fix ApexCharts Canvas - Đảm bảo không bị crop */
    .apexcharts-canvas {
        overflow: visible !important;
    }
    
    .apexcharts-svg {
        overflow: visible !important;
    }
    
    /* 5. Giảm opacity selection box */
    .apexcharts-selection-rect {
        opacity: 0.3 !important;
    }
    
    /* 6. Improve Toolbar Icons Style */
    .apexcharts-toolbar > div {
        margin: 0 3px !important;
    }
    
    .apexcharts-zoom-icon,
    .apexcharts-zoomin-icon,
    .apexcharts-zoomout-icon,
    .apexcharts-reset-icon,
    .apexcharts-download-icon,
    .apexcharts-menu-icon {
        width: 20px !important;
        height: 20px !important;
        cursor: pointer !important;
        color: #0ea5e9 !important;
        transition: all 0.2s ease !important;
    }
    
    .apexcharts-zoom-icon:hover,
    .apexcharts-zoomin-icon:hover,
    .apexcharts-zoomout-icon:hover,
    .apexcharts-reset-icon:hover,
    .apexcharts-download-icon:hover,
    .apexcharts-menu-icon:hover {

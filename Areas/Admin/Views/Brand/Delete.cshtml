@model B_M.Models.Entities.Brand
@{
    ViewBag.Title = "Xóa nhãn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h5><i class="fas fa-trash"></i> @ViewBag.Title</h5>
        <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
    </div>
    <div class="admin-card-body">
        <div class="alert alert-danger">
            Bạn có chắc chắn muốn xóa nhãn hàng "<strong>@Model.BrandName</strong>"?
        </div>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.BrandID)
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Xóa</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-times"></i> Hủy</a>
        }
    </div>
    
</div>



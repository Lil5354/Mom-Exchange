@model B_M.Models.BrandPermissionViewModel
@{
    ViewBag.Title = "Phân quyền Danh mục - " + Model.BrandName;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .permissions-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 30px;
        box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);
    }

    .brand-info {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .brand-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
    }

    .brand-details h4 {
        margin: 0 0 5px 0;
        font-size: 24px;
        font-weight: 700;
    }

    .brand-details p {
        margin: 0;
        opacity: 0.9;
        font-size: 14px;
    }

    .permission-controls {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        margin-bottom: 25px;
        overflow: hidden;
    }

    .control-header {
        background: #f8fafc;
        padding: 15px 20px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .control-header h6 {
        margin: 0;
        font-weight: 600;
        color: #374151;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .bulk-actions {
        display: flex;
        gap: 10px;
    }

    .bulk-actions button {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-select-all {
        background: #10b981;
        color: white;
    }

    .btn-select-all:hover {
        background: #059669;
    }

    .btn-select-none {
        background: #ef4444;
        color: white;
    }

    .btn-select-none:hover {
        background: #dc2626;
    }

    .categories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 15px;
        padding: 20px;
    }

    .category-card {
        background: #fff;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        padding: 15px;
        transition: all 0.2s;
        cursor: pointer;
        position: relative;
    }

    .category-card:hover {
        border-color: #3b82f6;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
    }

    .category-card.selected {
        border-color: #10b981;
        background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
    }

    .category-checkbox {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .category-name {
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 8px;
        padding-right: 30px;
        font-size: 16px;
    }

    .category-path {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 8px;
        font-style: italic;
    }

    .category-description {
        font-size: 13px;
        color: #6b7280;
        line-height: 1.4;
        margin-bottom: 10px;
    }

    .category-stats {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 11px;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .permission-summary {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        padding: 20px;
        margin-bottom: 25px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        text-align: center;
    }

    .summary-item {
        background: #f8fafc;
        border-radius: 8px;
        padding: 15px;
    }

    .summary-number {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 5px;
        color: #1e293b;
    }

    .summary-label {
        font-size: 12px;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .summary-item.total .summary-number { color: #3b82f6; }
    .summary-item.selected .summary-number { color: #10b981; }
    .summary-item.available .summary-number { color: #f59e0b; }

    .form-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 30px;
    }

    .btn {
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }

    .btn-secondary {
        background: #f3f4f6;
        color: #374151;
        border: 1px solid #d1d5db;
    }

    .btn-secondary:hover {
        background: #e5e7eb;
        text-decoration: none;
        color: #374151;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
    }

    .alert-danger {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #64748b;
    }

    .empty-state i {
        font-size: 48px;
        margin-bottom: 15px;
        opacity: 0.5;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="permissions-header">
    <div class="brand-info">
        <div class="brand-avatar">
            @(Model.BrandName.Substring(0, 1).ToUpper())
        </div>
        <div class="brand-details">
            <h4>@Model.BrandName</h4>
            <p>
                <i class="fas fa-user"></i> @Model.UserFullName (@Model.UserEmail)
            </p>
        </div>
    </div>
</div>

<div class="permission-summary">
    <h6 style="margin-bottom: 15px; color: #374151;">
        <i class="fas fa-chart-bar"></i> Tổng quan phân quyền
    </h6>
    <div class="summary-grid">
        <div class="summary-item total">
            <div class="summary-number" id="totalCount">@Model.Categories.Count</div>
            <div class="summary-label">Tổng danh mục B2C</div>
        </div>
        <div class="summary-item selected">
            <div class="summary-number" id="selectedCount">@Model.Categories.Count(c => c.IsGranted)</div>
            <div class="summary-label">Đã được phép</div>
        </div>
        <div class="summary-item available">
            <div class="summary-number" id="availableCount">@Model.Categories.Count(c => !c.IsGranted)</div>
            <div class="summary-label">Chưa được phép</div>
        </div>
    </div>
</div>

@using (Html.BeginForm("SavePermissions", "Brands", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.BrandID)
    @Html.HiddenFor(m => m.BrandName)

    if (Model.Categories.Any())
    {
        <div class="permission-controls">
            <div class="control-header">
                <h6>
                    <i class="fas fa-list"></i>
                    Danh mục được phép bán hàng (chỉ Category có IsB2CEnabled = true)
                </h6>
                <div class="bulk-actions">
                    <button type="button" class="btn-select-all" onclick="selectAll()">
                        <i class="fas fa-check-square"></i> Chọn tất cả
                    </button>
                    <button type="button" class="btn-select-none" onclick="selectNone()">
                        <i class="fas fa-square"></i> Bỏ chọn tất cả
                    </button>
                </div>
            </div>

            <div class="categories-grid">
                @for (int i = 0; i < Model.Categories.Count; i++)
                {
                    var category = Model.Categories[i];
                    <div class="category-card @(category.IsGranted ? "selected" : "")" 
                         onclick="toggleCategory(@i)" id="card-@i">
                        
                        @Html.CheckBoxFor(m => m.Categories[i].IsGranted, new { 
                            @class = "category-checkbox", 
                            onchange = "updateCard(" + i + ")" 
                        })
                        @Html.HiddenFor(m => m.Categories[i].CategoryID)
                        @Html.HiddenFor(m => m.Categories[i].CategoryName)
                        @Html.HiddenFor(m => m.Categories[i].Description)
                        @Html.HiddenFor(m => m.Categories[i].FullPath)

                        <div class="category-name">@category.CategoryName</div>
                        
                        @if (!string.IsNullOrEmpty(category.FullPath))
                        {
                            <div class="category-path">
                                <i class="fas fa-folder-tree"></i> @category.FullPath
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(category.Description))
                        {
                            <div class="category-description">
                                @(category.Description.Length > 120 ? category.Description.Substring(0, 120) + "..." : category.Description)
                            </div>
                        }
                        
                        <div class="category-stats">
                            <span>ID: #@category.CategoryID</span>
                            <span>
                                @if (category.IsGranted)
                                {
                                    <i class="fas fa-check-circle" style="color: #10b981;"></i>
                                    <span style="color: #10b981;">Được phép</span>
                                }
                                else
                                {
                                    <i class="fas fa-times-circle" style="color: #ef4444;"></i>
                                    <span style="color: #ef4444;">Chưa được phép</span>
                                }
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Lưu phân quyền
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    }
    else
    {
        <div class="admin-card">
            <div class="admin-card-body">
                <div class="empty-state">
                    <i class="fas fa-inbox"></i>
                    <h4>Không có danh mục B2C</h4>
                    <p>
                        Chưa có danh mục nào được bật chế độ B2C (IsB2CEnabled = true).<br>
                        Vui lòng tạo và bật chế độ B2C cho các danh mục trước.
                    </p>
                    <a href="@Url.Action("Index", "Category")" class="btn btn-primary" style="margin-top: 15px;">
                        <i class="fas fa-plus"></i> Quản lý danh mục
                    </a>
                </div>
            </div>
        </div>
    }
}

@section scripts {
    <script>
        function toggleCategory(index) {
            var checkbox = $('#Categories_' + index + '__IsGranted');
            var isChecked = checkbox.prop('checked');
            checkbox.prop('checked', !isChecked).trigger('change');
        }

        function updateCard(index) {
            var checkbox = $('#Categories_' + index + '__IsGranted');
            var card = $('#card-' + index);
            var isChecked = checkbox.prop('checked');
            
            if (isChecked) {
                card.addClass('selected');
            } else {
                card.removeClass('selected');
            }
            
            updateSummary();
        }

        function selectAll() {
            $('input[type="checkbox"][id*="IsGranted"]').prop('checked', true).trigger('change');
            $('.category-card').addClass('selected');
            updateSummary();
        }

        function selectNone() {
            $('input[type="checkbox"][id*="IsGranted"]').prop('checked', false).trigger('change');
            $('.category-card').removeClass('selected');
            updateSummary();
        }

        function updateSummary() {
            var total = @Model.Categories.Count;
            var selected = $('input[type="checkbox"][id*="IsGranted"]:checked').length;
            var available = total - selected;
            
            $('#selectedCount').text(selected);
            $('#availableCount').text(available);
        }

        // Prevent card click when clicking checkbox
        $('.category-checkbox').click(function(e) {
            e.stopPropagation();
        });

        // Form validation
        $('form').submit(function(e) {
            var selectedCount = $('input[type="checkbox"][id*="IsGranted"]:checked').length;
            
            if (selectedCount === 0) {
                if (!confirm('Bạn chưa chọn danh mục nào. Nhãn hàng này sẽ không có quyền bán trong danh mục nào. Bạn có muốn tiếp tục?')) {
                    e.preventDefault();
                    return false;
                }
            }
        });
    </script>
}



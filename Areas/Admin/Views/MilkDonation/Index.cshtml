@model B_M.Models.AdminMilkPostsViewModel
@{
    ViewBag.Title = "Quản Lý Sữa Mẹ";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-main-content">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="page-title">
                    <i class="fas fa-baby-carriage text-primary"></i> Quản Lý Bài Đăng Cho Tặng Sữa
                </h1>
                <div class="page-actions">
                    <a href="@Url.Action("Index", "MedicalRecords", new { area = "Admin" })" 
                       class="btn btn-outline-secondary">
                        <i class="fas fa-file-medical"></i> Quay lại Duyệt Xác Thực
                    </a>
                </div>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
            </div>
        }

        <!-- Filters -->
        <div class="admin-card">
            <div class="admin-card-header">
                <i class="fas fa-filter"></i> Lọc Bài Đăng
            </div>
            <div class="admin-card-body">
                <form method="get" class="form-inline">
                    <div class="form-group mr-3">
                        <label class="mr-2">Trạng thái:</label>
                        <select name="statusFilter" class="form-control" onchange="this.form.submit()">
                            <option value="">Tất cả</option>
                            <option value="1" @(Model.StatusFilter == "1" ? "selected" : "")>Đang mở</option>
                            <option value="2" @(Model.StatusFilter == "2" ? "selected" : "")>Đã đóng</option>
                        </select>
                    </div>
                    <a href="@Url.Action("Index", "MilkDonation", new { Area = "Admin" })" class="btn btn-secondary">
                        <i class="fas fa-redo"></i> Reset
                    </a>
                </form>
            </div>
        </div>

        <!-- Posts List -->
        <div class="admin-card">
            <div class="admin-card-header">
                Danh Sách Bài Đăng (@Model.TotalPosts)
            </div>
            <div class="admin-card-body">
                @if (Model.Posts != null && Model.Posts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th width="50">ID</th>
                                    <th>Người đăng</th>
                                    <th>Địa điểm</th>
                                    <th>Ngày vắt</th>
                                    <th width="100">Tầng</th>
                                    <th width="100">Trạng thái</th>
                                    <th width="150" class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var post in Model.Posts)
                                {
                                    <tr>
                                        <td>@post.PostID</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(post.DonorAvatarUrl ?? "/images/avatar-default.jpg")" 
                                                     alt="Avatar" 
                                                     class="rounded-circle mr-2"
                                                     style="width: 40px; height: 40px; object-fit: cover;">
                                                <div>
                                                    <strong>@post.DonorName</strong><br/>
                                                    <small class="text-muted">@post.DonorEmail</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@post.Location</td>
                                        <td>@(post.DateOfExpression.HasValue ? post.DateOfExpression.Value.ToString("dd/MM/yyyy") : "Chưa có")</td>
                                        <td>
                                            @if (post.VerificationTier == 1)
                                            {
                                                <span class="badge badge-warning">Tầng 1</span>
                                            }
                                            else if (post.VerificationTier == 3)
                                            {
                                                <span class="badge badge-success">Tầng 2</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Chưa xác định</span>
                                            }
                                        </td>
                                        <td>
                                            @if (post.Status == 1)
                                            {
                                                <span class="badge badge-success">Đang mở</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Đã đóng</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a href="@Url.Action("Details", "MilkDonation", new { Area = "Admin", id = post.PostID })" 
                                               class="btn btn-sm btn-primary">
                                                <i class="fas fa-eye"></i> Xem
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", "MilkDonation", new { Area = "Admin", page = Model.CurrentPage - 1, statusFilter = Model.StatusFilter })">
                                        <i class="fas fa-chevron-left"></i> Trước
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", "MilkDonation", new { Area = "Admin", page = i, statusFilter = Model.StatusFilter })">@i</a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", "MilkDonation", new { Area = "Admin", page = Model.CurrentPage + 1, statusFilter = Model.StatusFilter })">
                                        Sau <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle fa-3x mb-3"></i>
                        <h5>Không có bài đăng nào</h5>
                        <p class="mb-0">Chưa có bài đăng nào trong hệ thống.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


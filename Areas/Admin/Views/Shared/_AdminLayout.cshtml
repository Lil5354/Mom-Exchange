<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin Panel - MomExchange</title>

    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;800&display=swap" rel="stylesheet">
    
    <style>
        /* Admin Layout Styles - Ocean Blue Theme */
        :root {
            --primary-blue: #1e3a8a;
            --secondary-blue: #3b82f6;
            --light-blue: #dbeafe;
            --pastel-blue: #e0f2fe;
            --accent-blue: #0ea5e9;
            --dark-blue: #1e40af;
            --text-dark: #1e293b;
            --text-light: #64748b;
            --bg-light: #f8fafc;
            --white: #ffffff;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #06b6d4;
        }

        body {
            background: linear-gradient(135deg, var(--pastel-blue) 0%, var(--light-blue) 100%);
            font-family: 'Montserrat', sans-serif;
            color: var(--text-dark);
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, var(--primary-blue) 0%, var(--dark-blue) 100%);
            color: white;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            z-index: 1000;
            box-shadow: 4px 0 20px rgba(30, 58, 138, 0.3);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .admin-sidebar-header {
            padding: 25px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            text-align: center;
            background: rgba(255, 255, 255, 0.05);
        }

        .admin-sidebar-header h3 {
            margin: 0;
            color: white;
            font-weight: 800;
            font-size: 20px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .admin-sidebar-header p {
            margin: 8px 0 0 0;
            color: rgba(255, 255, 255, 0.8);
            font-size: 13px;
            font-weight: 500;
        }

        .admin-nav {
            padding: 25px 0;
        }

        .admin-nav-item {
            display: block;
            padding: 18px 25px;
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-left: 4px solid transparent;
            font-weight: 500;
            position: relative;
            overflow: hidden;
        }

        .admin-nav-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 100%;
            background: linear-gradient(90deg, var(--accent-blue), var(--secondary-blue));
            transition: width 0.3s ease;
            z-index: -1;
        }

        .admin-nav-item:hover {
            background-color: rgba(255,255,255,0.1);
            border-left-color: var(--accent-blue);
            color: white;
            text-decoration: none;
            transform: translateX(5px);
        }

        .admin-nav-item:hover::before {
            width: 100%;
        }

        .admin-nav-item.active {
            background: linear-gradient(90deg, rgba(14, 165, 233, 0.2), rgba(59, 130, 246, 0.1));
            border-left-color: var(--accent-blue);
            color: var(--accent-blue);
            font-weight: 600;
        }

        .admin-nav-item i {
            width: 20px;
            margin-right: 10px;
            text-align: center;
        }

        .admin-main {
            flex: 1;
            margin-left: 280px;
            padding: 0;
        }

        .admin-header {
            background: linear-gradient(135deg, var(--white) 0%, var(--pastel-blue) 100%);
            padding: 20px 35px;
            box-shadow: 0 4px 20px rgba(30, 58, 138, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(59, 130, 246, 0.1);
        }

        .admin-header h1 {
            margin: 0;
            color: var(--text-dark);
            font-size: 28px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .admin-user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .admin-user-info .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent-blue), var(--secondary-blue));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 18px;
            box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
            border: 3px solid rgba(255, 255, 255, 0.2);
        }

        .admin-user-info .user-details h6 {
            margin: 0;
            color: var(--text-dark);
            font-weight: 700;
            font-size: 16px;
        }

        .admin-user-info .user-details small {
            color: var(--text-light);
            font-weight: 500;
        }

        .admin-content {
            padding: 35px;
            background: transparent;
        }

        .admin-card {
            background: var(--white);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(30, 58, 138, 0.1);
            margin-bottom: 25px;
            border: 1px solid rgba(59, 130, 246, 0.1);
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .admin-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 40px rgba(30, 58, 138, 0.15);
        }

        .admin-card-header {
            padding: 25px 30px;
            border-bottom: 1px solid rgba(59, 130, 246, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(135deg, var(--pastel-blue), var(--white));
        }

        .admin-card-header h5 {
            margin: 0;
            color: var(--text-dark);
            font-weight: 700;
            font-size: 18px;
        }

        .admin-card-body {
            padding: 30px;
        }

        .btn-admin {
            background: linear-gradient(135deg, var(--accent-blue), var(--secondary-blue));
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
            position: relative;
            overflow: hidden;
        }

        .btn-admin::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        .btn-admin:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(14, 165, 233, 0.4);
            color: white;
        }

        .btn-admin:hover::before {
            left: 100%;
        }

        .btn-admin-secondary {
            background: linear-gradient(135deg, var(--text-light), #94a3b8);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 12px rgba(100, 116, 139, 0.3);
        }

        .btn-admin-secondary:hover {
            background: linear-gradient(135deg, #64748b, #475569);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(100, 116, 139, 0.4);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 35px;
        }

        .stat-card {
            background: var(--white);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(30, 58, 138, 0.1);
            text-align: center;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(59, 130, 246, 0.1);
            position: relative;
            overflow: visible;
            isolation: isolate;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-blue), var(--secondary-blue));
            z-index: 1;
        }

        .stat-card:hover {
            transform: translateY(-6px) scale(1.005);
            box-shadow: 0 16px 48px rgba(30, 58, 138, 0.2);
            z-index: 10;
        }

        .stat-card .stat-icon {
            width: 70px;
            height: 70px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 28px;
            color: white;
            background: linear-gradient(135deg, var(--accent-blue), var(--secondary-blue));
            box-shadow: 0 8px 20px rgba(14, 165, 233, 0.3);
            position: relative;
            z-index: 2;
        }

        .stat-card .stat-number {
            font-size: 36px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 8px;
            position: relative;
            z-index: 3;
        }

        .stat-card .stat-label {
            color: var(--text-light);
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            position: relative;
            z-index: 3;
        }

        .table-admin {
            width: 100%;
            border-collapse: collapse;
            margin-top: 25px;
            background: var(--white);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(30, 58, 138, 0.08);
        }

        .table-admin th,
        .table-admin td {
            padding: 20px;
            text-align: left;
            border-bottom: 1px solid rgba(59, 130, 246, 0.1);
        }

        .table-admin th {
            background: linear-gradient(135deg, var(--pastel-blue), var(--light-blue));
            font-weight: 700;
            color: var(--text-dark);
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-admin tr:hover {
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.05), rgba(59, 130, 246, 0.05));
        }

        .table-admin tr:last-child td {
            border-bottom: none;
        }

        .badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .badge-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
        }

        .badge-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
        }

        .badge-warning {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
        }

        .badge-info {
            background: linear-gradient(135deg, #06b6d4, #0891b2);
            color: white;
        }

        /* Settings Specific Styles */
        .settings-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 25px;
            margin-bottom: 35px;
        }

        .settings-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(59, 130, 246, 0.1);
        }

        .settings-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(30, 58, 138, 0.15);
            border-color: rgba(14, 165, 233, 0.3);
        }

        .settings-status {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            position: relative;
        }

        .status-indicator.active {
            background: linear-gradient(135deg, #10b981, #059669);
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
        }

        .status-indicator.active::after {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            border-radius: 50%;
            background: linear-gradient(135deg, #10b981, #059669);
            opacity: 0.3;
            animation: pulse 2s infinite;
        }

        .status-indicator.inactive {
            background: linear-gradient(135deg, #6b7280, #4b5563);
        }

        .status-indicator.warning {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            box-shadow: 0 0 8px rgba(245, 158, 11, 0.4);
        }

        .status-text {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .settings-form {
            position: relative;
        }

        .form-row {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            flex: 1;
            margin-bottom: 0;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--text-dark);
            font-size: 14px;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid rgba(59, 130, 246, 0.1);
            border-radius: 12px;
            font-size: 14px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: var(--white);
            color: var(--text-dark);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
            transform: translateY(-1px);
        }

        .form-control.is-valid {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
        }

        .form-control.is-invalid {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
        }

        .form-check-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            background: rgba(59, 130, 246, 0.05);
            border-radius: 12px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(59, 130, 246, 0.1);
        }

        .form-check:hover {
            background: rgba(59, 130, 246, 0.1);
            transform: translateY(-1px);
        }

        .form-check-input {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(59, 130, 246, 0.3);
            border-radius: 4px;
            background: var(--white);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .form-check-input:checked {
            background: linear-gradient(135deg, var(--accent-blue), var(--secondary-blue));
            border-color: var(--accent-blue);
        }

        .form-check-input:checked::after {
            content: '✓';
            color: white;
            font-size: 12px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        .form-check-label {
            font-weight: 500;
            color: var(--text-dark);
            cursor: pointer;
            margin: 0;
            font-size: 14px;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid rgba(59, 130, 246, 0.1);
        }

        .form-actions .btn-admin,
        .form-actions .btn-admin-secondary {
            min-width: 140px;
        }

        /* Custom checkbox styles */
        .form-check-input[type="checkbox"] {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
        }

        .form-check-input[type="checkbox"]:checked {
            background-image: none;
        }

        /* Select dropdown styles */
        select.form-control {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 12px center;
            background-repeat: no-repeat;
            background-size: 16px;
            padding-right: 40px;
        }

        /* Textarea styles */
        textarea.form-control {
            resize: vertical;
            min-height: 80px;
        }

        /* Loading animation */
        @@keyframes pulse {
            0%, 100% {
                opacity: 0.3;
                transform: scale(1);
            }
            50% {
                opacity: 0.6;
                transform: scale(1.1);
            }
        }

        /* Notification styles */
        .alert {
            border-radius: 12px;
            border: none;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
        }

        .alert-success {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.9), rgba(5, 150, 105, 0.9));
            color: white;
        }

        .alert-warning {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.9), rgba(217, 119, 6, 0.9));
            color: white;
        }

        .alert-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.9), rgba(220, 38, 38, 0.9));
            color: white;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .admin-sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .admin-main {
                margin-left: 0;
            }

            .admin-header {
                padding: 20px 25px;
            }

            .admin-content {
                padding: 25px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .admin-card {
                margin-bottom: 20px;
            }

            .admin-card-header,
            .admin-card-body {
                padding: 20px;
            }

            .settings-container {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .form-row {
                flex-direction: column;
                gap: 15px;
            }

            .form-check-group {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .form-actions {
                flex-direction: column;
                gap: 10px;
            }

            .form-actions .btn-admin,
            .form-actions .btn-admin-secondary {
                width: 100%;
                min-width: auto;
            }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="admin-sidebar">
            <div class="admin-sidebar-header">
                <h3><i class="fas fa-crown"></i> Admin Panel</h3>
                <p>MomExchange Management</p>
            </div>
            
            <nav class="admin-nav">
                <a href="@Url.Action("Index", "Admin", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-tachometer-alt"></i> Tổng quan
                </a>
                <a href="@Url.Action("Users", "Admin", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["Action"].ToString() == "Users" ? "active" : "")">
                    <i class="fas fa-users"></i> Quản lý người dùng
                </a>
                <a href="@Url.Action("Reports", "Admin", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["Action"].ToString() == "Reports" ? "active" : "")">
                    <i class="fas fa-chart-bar"></i> Báo cáo
                </a>
                <a href="@Url.Action("Index", "Category", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Category" ? "active" : "")">
                    <i class="fas fa-folder-tree"></i> Quản lý Danh mục
                </a>
                <a href="@Url.Action("Index", "Brand", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Brand" ? "active" : "")">
                    <i class="fas fa-tags"></i> Quản lý Nhãn hàng
                </a>
                <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Product" ? "active" : "")">
                    <i class="fas fa-box"></i> Quản lý Sản phẩm B2C
                </a>
                <a href="@Url.Action("Index", "Order", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Order" ? "active" : "")">
                    <i class="fas fa-receipt"></i> Quản lý Đơn hàng B2C
                </a>
                <a href="@Url.Action("Index", "MedicalRecords", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "MedicalRecords" ? "active" : "")">
                    <i class="fas fa-file-medical"></i> Duyệt Xác Thực Tầng 2
                </a>
                <div style="border-top: 1px solid rgba(255,255,255,0.1); margin: 20px 0;"></div>
                <a href="@Url.Action("Index", "Home", new { area = "" })" class="admin-nav-item">
                    <i class="fas fa-home"></i> Về trang chủ
                </a>
                <a href="@Url.Action("Logout", "Account", new { area = "" })" class="admin-nav-item">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="admin-main">
            <!-- Header -->
            <div class="admin-header">
                <h1>@ViewBag.Title</h1>
                <div style="display: flex; align-items: center; gap: 20px;">
                    <!-- Notification Bell -->
                    <div class="notification-bell-container" style="position: relative;">
                        <button class="notification-bell-btn" id="notificationBellBtn" style="background: none; border: none; position: relative; cursor: pointer;">
                            <i class="fas fa-bell" style="font-size: 24px; color: var(--primary-blue);"></i>
                            <span class="notification-badge" id="notificationBadge" style="display: none; position: absolute; top: -8px; right: -8px; background: var(--danger); color: white; border-radius: 50%; width: 20px; height: 20px; font-size: 11px; font-weight: bold; display: flex; align-items: center; justify-content: center;">0</span>
                        </button>
                        
                        <!-- Notification Dropdown -->
                        <div class="notification-dropdown" id="notificationDropdown" style="display: none; position: absolute; right: 0; top: 45px; width: 350px; max-height: 500px; background: white; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); z-index: 1050; overflow: hidden;">
                            <div class="notification-header" style="padding: 15px 20px; border-bottom: 1px solid #e5e7eb; background: linear-gradient(135deg, var(--primary-blue), var(--secondary-blue)); color: white;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <h6 style="margin: 0; font-weight: 600;">Thông báo</h6>
                                    <button class="btn btn-sm" onclick="markAllAsRead()" style="background: rgba(255,255,255,0.2); color: white; border: none; padding: 5px 10px; border-radius: 5px; font-size: 12px; cursor: pointer;">
                                        Đánh dấu đã đọc
                                    </button>
                                </div>
                            </div>
                            <div class="notification-list" id="notificationList" style="max-height: 400px; overflow-y: auto;">
                                <div class="text-center py-4">
                                    <i class="fas fa-spinner fa-spin" style="font-size: 24px; color: var(--primary-blue);"></i>
                                    <p class="mt-2 text-muted">Đang tải...</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="admin-user-info">
                        <div class="user-avatar">
                            @(Session["FullName"]?.ToString().Substring(0, 1).ToUpper() ?? "A")
                        </div>
                        <div class="user-details">
                            <h6>@Session["FullName"]</h6>
                            <small>Quản trị viên</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" style="background-color: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                        <strong>Thành công!</strong> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="float: right; background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="background-color: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                        <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="float: right; background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script>
        AOS.init({
            duration: 800,
            once: true
        });

        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut();
        }, 5000);
    </script>

    <!-- Notification Bell JavaScript -->
    <script>
        // Notification Bell functionality
        $(document).ready(function() {
            // Toggle notification dropdown
            $('#notificationBellBtn').on('click', function(e) {
                e.stopPropagation();
                $('#notificationDropdown').toggle();
                if ($('#notificationDropdown').is(':visible')) {
                    loadNotifications();
                }
            });

            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.notification-bell-container').length) {
                    $('#notificationDropdown').hide();
                }
            });

            // Load unread count on page load
            loadNotificationCount();

            // Poll for new notifications every 30 seconds
            setInterval(loadNotificationCount, 30000);
        });

        // Load notification count
        function loadNotificationCount() {
            $.ajax({
                url: '@Url.Action("GetUnreadCount", "NotificationApi", new { area = "" })',
                type: 'GET',
                success: function(response) {
                    if (response.success && response.count > 0) {
                        $('#notificationBadge').text(response.count > 9 ? '9+' : response.count).show();
                    } else {
                        $('#notificationBadge').hide();
                    }
                },
                error: function() {
                    console.log('Error loading notification count');
                }
            });
        }

        // Load notifications list
        function loadNotifications() {
            $.ajax({
                url: '@Url.Action("GetNotifications", "NotificationApi", new { area = "" })',
                type: 'GET',
                data: { page: 0, size: 10 },
                success: function(response) {
                    if (response.success && response.data && response.data.length > 0) {
                        var html = '';
                        response.data.forEach(function(notif) {
                            var unreadClass = notif.IsRead ? '' : 'unread';
                            var unreadStyle = notif.IsRead ? '' : 'background: #f0f9ff; border-left: 3px solid #3b82f6;';
                            
                            html += '<div class="notification-item ' + unreadClass + '" style="padding: 15px 20px; border-bottom: 1px solid #e5e7eb; cursor: pointer; transition: background 0.2s; ' + unreadStyle + '" onclick="markAsRead(' + notif.Id + ', \'' + (notif.Link || '#') + '\')">';
                            html += '<div style="display: flex; justify-content: space-between;">';
                            html += '<strong style="color: #1e3a8a; font-size: 14px;">' + notif.Title + '</strong>';
                            html += '<small style="color: #6b7280;">' + formatDate(notif.CreatedAt) + '</small>';
                            html += '</div>';
                            html += '<p style="margin: 5px 0 0 0; color: #4b5563; font-size: 13px;">' + notif.Message + '</p>';
                            html += '</div>';
                        });
                        $('#notificationList').html(html);
                    } else {
                        $('#notificationList').html('<div class="text-center py-4"><i class="fas fa-inbox" style="font-size: 40px; color: #d1d5db;"></i><p class="mt-2 text-muted">Không có thông báo mới</p></div>');
                    }
                },
                error: function() {
                    $('#notificationList').html('<div class="text-center py-4"><i class="fas fa-exclamation-circle text-danger"></i><p class="mt-2 text-danger">Lỗi tải thông báo</p></div>');
                }
            });
        }

        // Mark single notification as read and navigate
        function markAsRead(id, link) {
            $.ajax({
                url: '@Url.Action("MarkAsRead", "NotificationApi", new { area = "" })',
                type: 'POST',
                data: { id: id },
                success: function() {
                    loadNotificationCount();
                    if (link && link !== '#') {
                        window.location.href = link;
                    }
                }
            });
        }

        // Mark all as read
        function markAllAsRead() {
            $.ajax({
                url: '@Url.Action("MarkAllAsRead", "NotificationApi", new { area = "" })',
                type: 'POST',
                success: function() {
                    loadNotificationCount();
                    loadNotifications();
                }
            });
        }

        // Format date helper
        function formatDate(dateString) {
            var date = new Date(dateString);
            var now = new Date();
            var diff = Math.floor((now - date) / 1000); // seconds

            if (diff < 60) return 'Vừa xong';
            if (diff < 3600) return Math.floor(diff / 60) + ' phút trước';
            if (diff < 86400) return Math.floor(diff / 3600) + ' giờ trước';
            if (diff < 604800) return Math.floor(diff / 86400) + ' ngày trước';
            
            return date.toLocaleDateString('vi-VN');
        }
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>

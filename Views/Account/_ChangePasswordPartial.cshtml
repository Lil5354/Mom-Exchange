@model B_M.Models.ChangePasswordViewModel
@{
    Layout = null;
}
<div class="modal-overlay" id="changePasswordModal">
    <div class="modal-content-custom" style="width:520px;max-width:95vw;">
        <div class="modal-header-custom">
            <h3><i class="fa-solid fa-key text-primary"></i> Đổi mật khẩu</h3>
            <button type="button" class="modal-close" onclick="closeModal('changePasswordModal')">&times;</button>
        </div>
        <div class="modal-body-custom">
            <div class="alert alert-info mb-4">
                <i class="fa-solid fa-info-circle"></i>
                <strong>Thông tin tài khoản:</strong> Bạn đang đổi mật khẩu cho tài khoản này.
            </div>
            
            @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { id = "changePasswordForm", onsubmit = "return submitChangePassword(event)" }))
            {
                @Html.AntiForgeryToken()
                
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-user text-primary"></i> @Html.DisplayNameFor(m => m.Username)
                    </label>
                    <input type="text" class="form-control" value="@Model.Username" readonly 
                           style="background-color: #e9ecef; border: 2px solid #dee2e6; font-weight: 500;" />
                </div>
                
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-envelope text-primary"></i> @Html.DisplayNameFor(m => m.Email)
                    </label>
                    <input type="text" class="form-control" value="@Model.Email" readonly 
                           style="background-color: #e9ecef; border: 2px solid #dee2e6; font-weight: 500;" />
                </div>
                
                <hr class="my-4" />
                
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-lock text-warning"></i> @Html.DisplayNameFor(m => m.CurrentPassword)
                    </label>
                    @Html.PasswordFor(m => m.CurrentPassword, new { 
                        @class = "form-control form-control-lg", 
                        placeholder = "Nhập mật khẩu hiện tại",
                        style = "border: 2px solid #ffc107;"
                    })
                    @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger small mt-1" })
                </div>
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-key text-success"></i> @Html.DisplayNameFor(m => m.NewPassword)
                    </label>
                    @Html.PasswordFor(m => m.NewPassword, new { 
                        @class = "form-control form-control-lg", 
                        placeholder = "Nhập mật khẩu mới (tối thiểu 6 ký tự)",
                        style = "border: 2px solid #28a745;"
                    })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small mt-1" })
                </div>
                
                <div class="form-group mb-4">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-shield-check text-success"></i> @Html.DisplayNameFor(m => m.ConfirmPassword)
                    </label>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { 
                        @class = "form-control form-control-lg", 
                        placeholder = "Nhập lại mật khẩu mới",
                        style = "border: 2px solid #28a745;"
                    })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1" })
                </div>
                
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-check-circle"></i> Cập nhật mật khẩu
                    </button>
                </div>
                
                <div class="mt-4 text-center">
                    <div class="alert alert-warning py-2">
                        <i class="fa-solid fa-info-circle"></i>
                        <small><strong>Lưu ý:</strong> Mật khẩu mới phải có ít nhất <strong>6 ký tự</strong></small>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


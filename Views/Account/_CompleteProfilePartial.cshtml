@model B_M.Models.CompleteProfileViewModel

<div class="complete-profile-modal-content">
    <div class="modal-header-section" style="text-align: center; padding: 20px; background: linear-gradient(135deg, #e15b7f, #f47b8e); color: white; border-radius: 15px 15px 0 0;">
        <h3 style="margin: 0 0 10px 0;">
            <i class="fas fa-user-plus" style="margin-right: 8px;"></i>
            Hoàn thiện hồ sơ
        </h3>
        <p style="margin: 0; opacity: 0.9;">Chào mừng @Model.FullName! Hãy hoàn thiện thông tin để sử dụng đầy đủ tính năng</p>
    </div>

    @using (Html.BeginForm("CompleteProfile", "Account", FormMethod.Post, new { @class = "complete-profile-form", id = "completeProfileForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserID)
        @Html.HiddenFor(m => m.Email)
        @Html.HiddenFor(m => m.FullName)
        @Html.HiddenFor(m => m.Address)

        <div class="modal-body-section" style="padding: 30px;">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label for="UserName" style="font-weight: bold; color: #333; margin-bottom: 8px; display: block;">
                            <i class="fas fa-user" style="margin-right: 8px; color: #e15b7f;"></i>
                            Tên đăng nhập <span style="color: #dc3545;">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.UserName, new { 
                            @class = "form-control", 
                            @placeholder = "Nhập tên đăng nhập để đăng nhập bằng cách khác",
                            @required = "required",
                            @style = "padding: 12px; font-size: 16px; border-radius: 10px;"
                        })
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                        <small class="form-text text-muted">Tên đăng nhập này sẽ dùng để đăng nhập thay vì email</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label for="PhoneNumber" style="font-weight: bold; color: #333; margin-bottom: 8px; display: block;">
                            <i class="fas fa-phone" style="margin-right: 8px; color: #e15b7f;"></i>
                            Số điện thoại
                        </label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { 
                            @class = "form-control", 
                            @placeholder = "Nhập số điện thoại (không bắt buộc)",
                            @type = "tel",
                            @style = "padding: 12px; font-size: 16px; border-radius: 10px;"
                        })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label for="Password" style="font-weight: bold; color: #333; margin-bottom: 8px; display: block;">
                            <i class="fas fa-lock" style="margin-right: 8px; color: #e15b7f;"></i>
                            Mật khẩu <span style="color: #dc3545;">*</span>
                        </label>
                        @Html.PasswordFor(m => m.Password, new { 
                            @class = "form-control", 
                            @placeholder = "Nhập mật khẩu mới",
                            @required = "required",
                            @style = "padding: 12px; font-size: 16px; border-radius: 10px;"
                        })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        <small class="form-text text-muted">Mật khẩu tối thiểu 6 ký tự</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label for="ConfirmPassword" style="font-weight: bold; color: #333; margin-bottom: 8px; display: block;">
                            <i class="fas fa-lock" style="margin-right: 8px; color: #e15b7f;"></i>
                            Xác nhận mật khẩu <span style="color: #dc3545;">*</span>
                        </label>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { 
                            @class = "form-control", 
                            @placeholder = "Nhập lại mật khẩu",
                            @required = "required",
                            @style = "padding: 12px; font-size: 16px; border-radius: 10px;"
                        })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label for="provinceSelect" style="font-weight: bold; color: #333; margin-bottom: 8px; display: block;">
                            <i class="fas fa-map-marker-alt" style="margin-right: 8px; color: #e15b7f;"></i>
                            Tỉnh/Thành
                        </label>
                        <select id="provinceSelect" class="form-control" name="ProvinceSelect" style="padding: 12px; font-size: 16px; border-radius: 10px;">
                            <option value="">-- Chọn Tỉnh/Thành --</option>
                            <option>TP Hà Nội</option>
                            <option>TP Huế</option>
                            <option>Quảng Ninh</option>
                            <option>Cao Bằng</option>
                            <option>Lạng Sơn</option>
                            <option>Lai Châu</option>
                            <option>Điện Biên</option>
                            <option>Sơn La</option>
                            <option>Thanh Hóa</option>
                            <option>Nghệ An</option>
                            <option>Hà Tĩnh</option>
                            <option>Tuyên Quang</option>
                            <option>Lào Cai</option>
                            <option>Thái Nguyên</option>
                            <option>Phú Thọ</option>
                            <option>Bắc Ninh</option>
                            <option>Hưng Yên</option>
                            <option>TP Hải Phòng</option>
                            <option>Ninh Bình</option>
                            <option>Quảng Trị</option>
                            <option>TP Đà Nẵng</option>
                            <option>Quảng Ngãi</option>
                            <option>Gia Lai</option>
                            <option>Khánh Hòa</option>
                            <option>Lâm Đồng</option>
                            <option>Đắk Lắk</option>
                            <option>TPHCM</option>
                            <option>Đồng Nai</option>
                            <option>Tây Ninh</option>
                            <option>TP Cần Thơ</option>
                            <option>Vĩnh Long</option>
                            <option>Đồng Tháp</option>
                            <option>Cà Mau</option>
                            <option>An Giang</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label for="detailedAddress" style="font-weight: bold; color: #333; margin-bottom: 8px; display: block;">
                            <i class="fas fa-home" style="margin-right: 8px; color: #e15b7f;"></i>
                            Địa chỉ cụ thể
                        </label>
                        <input id="detailedAddress" type="text" class="form-control" name="DetailedAddressInput" placeholder="Số nhà, đường, phường/xã, quận/huyện" style="padding: 12px; font-size: 16px; border-radius: 10px;" />
                        <small class="form-text text-muted">Địa chỉ sẽ được lưu theo định dạng: "[Chi tiết], [Tỉnh/Thành]"</small>
                    </div>
                </div>
            </div>

            <div class="alert alert-info" style="background-color: #e3f2fd; border: none; border-radius: 10px; padding: 15px; margin-bottom: 20px;">
                <i class="fas fa-info-circle" style="margin-right: 8px;"></i>
                <strong>Lưu ý:</strong> Sau khi hoàn thiện, bạn có thể đăng nhập bằng:
                <ul style="margin-bottom: 0; margin-top: 10px; padding-left: 20px;">
                    <li>Email: <strong>@Model.Email</strong></li>
                    <li>Tên đăng nhập: <strong id="username-preview">[Sẽ hiển thị sau khi nhập]</strong></li>
                    <li>Hoặc tiếp tục dùng Google</li>
                </ul>
            </div>
        </div>

        <div class="modal-footer-section" style="padding: 20px; display: flex; gap: 10px; justify-content: flex-end; border-top: 1px solid #e9ecef;">
            <button type="submit" name="submitType" value="complete" class="btn btn-primary" style="padding: 12px 30px; font-size: 16px; font-weight: 600; border-radius: 10px; background: linear-gradient(135deg, #e15b7f, #f47b8e); border: none;">
                <i class="fas fa-check" style="margin-right: 8px;"></i>
                Hoàn thiện hồ sơ
            </button>
            <button type="submit" name="submitType" value="skip" class="btn btn-outline-primary" style="padding: 12px 30px; font-size: 16px; border-radius: 10px; border: 2px solid #e15b7f; color: #e15b7f; background: transparent;">
                <i class="fas fa-forward" style="margin-right: 8px;"></i>
                Bỏ qua
            </button>
            <button type="button" class="btn btn-secondary" onclick="closeCompleteProfileModal()" style="padding: 12px 30px; font-size: 16px; border-radius: 10px;">
                <i class="fas fa-times" style="margin-right: 8px;"></i>
                Đóng
            </button>
        </div>
    }
</div>

<style>
    .complete-profile-form .form-control:focus {
        border-color: #e15b7f;
        box-shadow: 0 0 0 0.2rem rgba(225, 91, 127, 0.25);
    }
    
    .complete-profile-form .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(225, 91, 127, 0.4);
        background: linear-gradient(135deg, #d14a6f, #e36a7e);
    }
    
    .complete-profile-form .btn-outline-primary:hover {
        background: linear-gradient(135deg, #e15b7f, #f47b8e);
        border-color: #e15b7f;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 3px 10px rgba(225, 91, 127, 0.3);
    }
</style>

<script>
    // Preview username
    document.getElementById('UserName').addEventListener('input', function() {
        const preview = document.getElementById('username-preview');
        if (this.value.trim()) {
            preview.textContent = this.value;
        } else {
            preview.textContent = '[Sẽ hiển thị sau khi nhập]';
        }
    });

    // Address: combine province + detailed address before submitting
    (function () {
        var form = document.getElementById('completeProfileForm');
        if (form) {
            form.addEventListener('submit', function () {
                var p = document.getElementById('provinceSelect').value;
                var d = document.getElementById('detailedAddress').value;
                var combined = (d ? d.trim() : '').replace(/\s+,/g, ',');
                if (p) {
                    combined = combined ? (combined + ', ' + p) : p;
                }
                document.getElementById('Address').value = combined;
            });
        }
    })();
</script>


@model B_M.Models.ForgotPasswordRequestViewModel
@{
    Layout = null;
}
<div class="modal-overlay" id="forgotRequestModal">
    <div class="modal-content-custom" style="width:520px;max-width:95vw;">
        <div class="modal-header-custom">
            <h3><i class="fa-solid fa-envelope"></i> Quên mật khẩu</h3>
            <button type="button" class="modal-close" onclick="closeModal('forgotRequestModal')">&times;</button>
        </div>
        <div class="modal-body-custom">
            <p>Nhập tên đăng nhập hoặc email. Nếu tài khoản tồn tại, hệ thống sẽ gửi mã xác thực 6 số đến email của bạn.</p>
            @using (Html.BeginForm("ForgotPasswordRequest", "Account", FormMethod.Post, new { id = "forgotPasswordRequestForm", onsubmit = "return submitForgotRequest(event)" }))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    @Html.LabelFor(m => m.UsernameOrEmail)
                    @Html.TextBoxFor(m => m.UsernameOrEmail, new { @class = "form-control", placeholder = "Tên đăng nhập hoặc Email" })
                    @Html.ValidationMessageFor(m => m.UsernameOrEmail, "", new { @class = "text-danger" })
                </div>
                <div class="text-right">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> Gửi mã</button>
                </div>
            }
        </div>
    </div>
</div>


@model B_M.Models.ForgotPasswordVerifyViewModel
@{
    Layout = null;
}
<div class="modal-overlay" id="forgotVerifyModal">
    <div class="modal-content-custom" style="width:520px;max-width:95vw;">
        <div class="modal-header-custom">
            <h3><i class="fa-solid fa-shield-check text-primary"></i> Xác thực mã bảo mật</h3>
            <button type="button" class="modal-close" onclick="closeModal('forgotVerifyModal')">&times;</button>
        </div>
        <div class="modal-body-custom">
            <div class="alert alert-info mb-4">
                <i class="fa-solid fa-info-circle"></i>
                <strong>Kiểm tra email của bạn!</strong><br>
                Chúng tôi đã gửi mã xác thực 6 chữ số đến email: <strong>@Model.UsernameOrEmail</strong>
            </div>
            
            @using (Html.BeginForm("ForgotPasswordVerify", "Account", FormMethod.Post, new { id = "forgotVerifyForm", onsubmit = "return submitForgotVerify(event)" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UsernameOrEmail)
                
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-envelope text-primary"></i> Email đã gửi mã
                    </label>
                    <input type="text" class="form-control" value="@Model.UsernameOrEmail" readonly 
                           style="background-color: #e9ecef; border: 2px solid #dee2e6; font-weight: 500;" />
                </div>
                
                <div class="form-group mb-4">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-key text-warning"></i> @Html.DisplayNameFor(m => m.Code)
                    </label>
                    @Html.TextBoxFor(m => m.Code, new { 
                        @class = "form-control form-control-lg", 
                        placeholder = "000000", 
                        maxlength = "6", 
                        style = "text-align: center; font-size: 24px; letter-spacing: 8px; font-weight: bold; border: 2px solid #007bff;",
                        autocomplete = "off"
                    })
                    @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger small mt-1" })
                </div>
                
                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary" onclick="closeModal('forgotVerifyModal'); openForgotPasswordModal();">
                        <i class="fa-solid fa-arrow-left"></i> Quay lại
                    </button>
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="fa-solid fa-check-circle"></i> Xác thực mã
                    </button>
                </div>
            }
            
            <div class="mt-4 text-center">
                <div class="alert alert-warning py-2">
                    <i class="fa-solid fa-clock text-warning"></i>
                    <small><strong>Lưu ý:</strong> Mã xác thực có hiệu lực trong <strong>10 phút</strong></small>
                </div>
                <button type="button" class="btn btn-link btn-sm text-decoration-none" onclick="resendVerificationCode('@Model.UsernameOrEmail')">
                    <i class="fa-solid fa-refresh"></i> Gửi lại mã xác thực
                </button>
            </div>
        </div>
    </div>
</div>


@model B_M.Models.ResetPasswordViewModel
@{
    Layout = null;
}
<div class="modal-overlay" id="resetPasswordModal">
    <div class="modal-content-custom" style="width:520px;max-width:95vw;">
        <div class="modal-header-custom">
            <h3><i class="fa-solid fa-lock-open text-success"></i> Đặt mật khẩu mới</h3>
            <button type="button" class="modal-close" onclick="closeModal('resetPasswordModal')">&times;</button>
        </div>
        <div class="modal-body-custom">
            <div class="alert alert-success mb-4">
                <i class="fa-solid fa-check-circle"></i>
                <strong>Xác thực thành công!</strong><br>
                Bây giờ bạn có thể đặt mật khẩu mới cho tài khoản của mình.
            </div>
            
            @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "resetPasswordForm", onsubmit = "return submitResetPassword(event)" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UsernameOrEmail)
                
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-user text-primary"></i> @Html.DisplayNameFor(m => m.Username)
                    </label>
                    <input type="text" class="form-control" value="@Model.Username" readonly 
                           style="background-color: #e9ecef; border: 2px solid #dee2e6; font-weight: 500;" />
                </div>
                
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-envelope text-primary"></i> @Html.DisplayNameFor(m => m.Email)
                    </label>
                    <input type="text" class="form-control" value="@Model.Email" readonly 
                           style="background-color: #e9ecef; border: 2px solid #dee2e6; font-weight: 500;" />
                </div>
                
                <hr class="my-4" />
                
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-key text-success"></i> @Html.DisplayNameFor(m => m.NewPassword)
                    </label>
                    @Html.PasswordFor(m => m.NewPassword, new { 
                        @class = "form-control form-control-lg", 
                        placeholder = "Nhập mật khẩu mới (tối thiểu 6 ký tự)",
                        style = "border: 2px solid #28a745;"
                    })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small mt-1" })
                </div>
                
                <div class="form-group mb-4">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-shield-check text-success"></i> @Html.DisplayNameFor(m => m.ConfirmPassword)
                    </label>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { 
                        @class = "form-control form-control-lg", 
                        placeholder = "Nhập lại mật khẩu mới",
                        style = "border: 2px solid #28a745;"
                    })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1" })
                </div>
                
                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fa-solid fa-check-circle"></i> Đặt lại mật khẩu
                    </button>
                </div>
            }
            
            <div class="mt-4 text-center">
                <div class="alert alert-info py-2">
                    <i class="fa-solid fa-info-circle"></i>
                    <small><strong>Lưu ý:</strong> Mật khẩu phải có ít nhất <strong>6 ký tự</strong></small>
                </div>
            </div>
        </div>
    </div>
</div>


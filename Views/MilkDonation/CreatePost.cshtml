@model B_M.Models.CreateMilkDonationPostViewModel
@{
    ViewBag.Title = "Đăng tin cho tặng sữa mẹ";
}

<div class="create-post-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="create-post-card">
                    <div class="post-header">
                        <h2><i class="fa-solid fa-plus-circle"></i> Đăng tin cho tặng sữa mẹ</h2>
                        <p class="text-muted">Chia sẻ sữa mẹ với cộng đồng một cách an toàn và minh bạch</p>
                    </div>

                    <div class="verification-info">
                        <div class="alert alert-info">
                            <i class="fa-solid fa-info-circle"></i>
                            <strong>Mức độ xác thực hiện tại:</strong> @Model.VerificationTierText
                        </div>
                    </div>

                    @using (Html.BeginForm("CreatePost", "MilkDonation", FormMethod.Post, new { @class = "create-post-form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.UserID)
                        @Html.HiddenFor(m => m.DonorName)
                        @Html.HiddenFor(m => m.VerificationTier)

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fa-solid fa-map-marker-alt"></i>
                                @Html.DisplayNameFor(m => m.Location)
                            </label>
                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", @placeholder = "Ví dụ: Quận 1, TP.HCM" })
                            @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fa-solid fa-calendar"></i>
                                @Html.DisplayNameFor(m => m.CollectionDate)
                            </label>
                            @Html.TextBoxFor(m => m.CollectionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                            @Html.ValidationMessageFor(m => m.CollectionDate, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fa-solid fa-utensils"></i>
                                @Html.DisplayNameFor(m => m.MotherDietInfo)
                            </label>
                            @Html.TextAreaFor(m => m.MotherDietInfo, new { @class = "form-control", @rows = 4, @placeholder = "Mô tả chi tiết về chế độ ăn uống của bạn..." })
                            @Html.ValidationMessageFor(m => m.MotherDietInfo, "", new { @class = "text-danger" })
                            <small class="form-text text-muted">
                                <i class="fa-solid fa-info-circle"></i>
                                Bao gồm: thực phẩm thường ăn, vitamin bổ sung, thuốc đang dùng...
                            </small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fa-solid fa-snowflake"></i>
                                @Html.DisplayNameFor(m => m.StorageMethod)
                            </label>
                            @Html.TextAreaFor(m => m.StorageMethod, new { @class = "form-control", @rows = 4, @placeholder = "Mô tả cách bạn bảo quản sữa..." })
                            @Html.ValidationMessageFor(m => m.StorageMethod, "", new { @class = "text-danger" })
                            <small class="form-text text-muted">
                                <i class="fa-solid fa-info-circle"></i>
                                Bao gồm: nhiệt độ bảo quản, loại túi/hộp, thời gian bảo quản...
                            </small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fa-solid fa-sticky-note"></i>
                                @Html.DisplayNameFor(m => m.Note)
                            </label>
                            @Html.TextAreaFor(m => m.Note, new { @class = "form-control", @rows = 3, @placeholder = "Ghi chú thêm về sữa hoặc điều kiện trao đổi..." })
                            @Html.ValidationMessageFor(m => m.Note, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fa-solid fa-paper-plane"></i>
                                Đăng tin cho tặng
                            </button>
                            <a href="@Url.Action("Index", "MilkDonation")" class="btn btn-outline-secondary btn-lg">
                                <i class="fa-solid fa-times"></i>
                                Hủy bỏ
                            </a>
                        </div>
                    }
                </div>

                <div class="info-card">
                    <h4><i class="fa-solid fa-info-circle"></i> Lưu ý quan trọng</h4>
                    <div class="info-content">
                        <div class="alert alert-warning">
                            <h5><i class="fa-solid fa-exclamation-triangle"></i> Nguyên tắc phi thương mại</h5>
                            <ul>
                                <li>Hoàn toàn miễn phí - không được thu tiền</li>
                                <li>Dựa trên tình yêu thương và chia sẻ</li>
                                <li>Người nhận tự chịu trách nhiệm về sức khỏe</li>
                            </ul>
                        </div>

                        <div class="alert alert-info">
                            <h5><i class="fa-solid fa-shield-alt"></i> Về mức độ xác thực</h5>
                            <p><strong>Tầng 1:</strong> Bài đăng sẽ có "Thẻ vàng" với cảnh báo về mức độ xác thực</p>
                            <p><strong>Tầng 2:</strong> Bài đăng sẽ có "Thẻ xanh" với xác nhận đã được kiểm tra y tế</p>
                        </div>

                        <div class="alert alert-success">
                            <h5><i class="fa-solid fa-heart"></i> Cam kết của bạn</h5>
                            <p>Bằng việc đăng tin, bạn cam kết:</p>
                            <ul>
                                <li>Cung cấp thông tin trung thực</li>
                                <li>Tuân thủ các nguyên tắc an toàn</li>
                                <li>Chia sẻ với tinh thần nhân đạo</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/Content/milk-donation-style.css" rel="stylesheet" />
}

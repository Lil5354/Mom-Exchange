@model B_M.Models.CreateProductViewModel

@{
    ViewBag.Title = "Đăng sản phẩm mới";
}

<div class="create-product-container">
    <div class="create-product-header" data-aos="fade-up">
        <h1><i class="fa-solid fa-plus-circle"></i> Đăng sản phẩm mới</h1>
        <p>Chia sẻ sản phẩm của bạn với cộng đồng các mẹ</p>
    </div>

    @using (Html.BeginForm("Create", "Product", FormMethod.Post, new { enctype = "multipart/form-data", @class = "create-product-form" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-sections">
            <!-- Basic Information -->
            <div class="form-section" data-aos="fade-up" data-aos-delay="100">
                <h2><i class="fa-solid fa-info-circle"></i> Thông tin cơ bản</h2>
                
                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(model => model.CategoryID, new { @class = "form-label" })
                        @Html.DropDownListFor(model => model.CategoryID, new SelectList(Model.Categories, "CategoryID", "CategoryName"), "-- Chọn danh mục --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "error-message" })
                    </div>
                    
                    <div class="form-group">
                        @Html.LabelFor(model => model.PostingType, new { @class = "form-label" })
                        @Html.DropDownListFor(model => model.PostingType, new SelectList(new[] {
                            new { Value = "Sell", Text = "Bán" },
                            new { Value = "Exchange", Text = "Trao đổi" },
                            new { Value = "Donate", Text = "Cho tặng" }
                        }, "Value", "Text"), new { @class = "form-select", @id = "postingType" })
                        @Html.ValidationMessageFor(model => model.PostingType, "", new { @class = "error-message" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ProductName, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.ProductName, new { @class = "form-input", @placeholder = "Ví dụ: Xe đẩy em bé Aprica còn mới 95%" })
                    @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "error-message" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Description, new { @class = "form-label" })
                    @Html.TextAreaFor(model => model.Description, new { @class = "form-textarea", @rows = "5", @placeholder = "Mô tả chi tiết về sản phẩm: tình trạng, thời gian sử dụng, lý do bán..." })
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "error-message" })
                </div>

                <div class="form-row">
                    <div class="form-group" id="priceGroup">
                        @Html.LabelFor(model => model.Price, new { @class = "form-label" })
                        <div class="input-group">
                            @Html.TextBoxFor(model => model.Price, new { @class = "form-input", @placeholder = "0", @type = "number", @min = "0" })
                            <span class="input-addon">VND</span>
                        </div>
                        @Html.ValidationMessageFor(model => model.Price, "", new { @class = "error-message" })
                    </div>
                    
                    <div class="form-group">
                        @Html.LabelFor(model => model.Quantity, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Quantity, new { @class = "form-input", @placeholder = "1", @type = "number", @min = "1" })
                        @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "error-message" })
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(model => model.ProductCondition, new { @class = "form-label" })
                        @Html.DropDownListFor(model => model.ProductCondition, new SelectList(new[] {
                            "Mới 100%",
                            "Còn mới 95%", 
                            "Còn mới 90%",
                            "Còn mới 80%",
                            "Đã sử dụng - Tốt",
                            "Đã sử dụng - Khá",
                            "Cần sửa chữa"
                        }), "-- Chọn tình trạng --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.ProductCondition, "", new { @class = "error-message" })
                    </div>
                    
                    <div class="form-group">
                        @Html.LabelFor(model => model.Location, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Location, new { @class = "form-input", @placeholder = "Ví dụ: Quận 1, TP.HCM" })
                        @Html.ValidationMessageFor(model => model.Location, "", new { @class = "error-message" })
                    </div>
                </div>
            </div>

            <!-- Affiliate Marketing -->
            <div class="form-section affiliate-section" data-aos="fade-up" data-aos-delay="200">
                <h2><i class="fa-solid fa-handshake"></i> Affiliate Marketing</h2>
                <p class="section-description">Cho phép người khác quảng bá sản phẩm của bạn và nhận hoa hồng</p>
                
                <div class="form-group checkbox-group">
                    <div class="checkbox-wrapper">
                        @Html.CheckBoxFor(model => model.IsAffiliateEnabled, new { @class = "checkbox-input", @id = "affiliateEnabled" })
                        <label for="affiliateEnabled" class="checkbox-label">
                            Bật Affiliate Marketing cho sản phẩm này
                        </label>
                    </div>
                </div>

                <div id="affiliateSettings" class="affiliate-settings" style="display: none;">
                    <div class="form-group">
                        @Html.LabelFor(model => model.AffiliateCommissionRate, new { @class = "form-label" })
                        <div class="input-group">
                            @Html.TextBoxFor(model => model.AffiliateCommissionRate, new { @class = "form-input", @placeholder = "5.0", @type = "number", @min = "0.1", @max = "50", @step = "0.1" })
                            <span class="input-addon">%</span>
                        </div>
                        <small class="help-text">Tỷ lệ hoa hồng sẽ trả cho người quảng bá (0.1% - 50%)</small>
                        @Html.ValidationMessageFor(model => model.AffiliateCommissionRate, "", new { @class = "error-message" })
                    </div>
                    
                    <div class="affiliate-benefits">
                        <h4>Lợi ích của Affiliate Marketing:</h4>
                        <ul>
                            <li><i class="fa-solid fa-check"></i> Tăng khả năng tiếp cận khách hàng</li>
                            <li><i class="fa-solid fa-check"></i> Chỉ trả hoa hồng khi có đơn hàng thành công</li>
                            <li><i class="fa-solid fa-check"></i> Sản phẩm được ưu tiên hiển thị</li>
                            <li><i class="fa-solid fa-check"></i> Nhận hỗ trợ marketing từ cộng đồng</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Product Images -->
            <div class="form-section" data-aos="fade-up" data-aos-delay="300">
                <h2><i class="fa-solid fa-images"></i> Hình ảnh sản phẩm</h2>
                <p class="section-description">Tải lên tối đa 5 hình ảnh để thu hút khách hàng</p>
                
                <div class="image-upload-area">
                    <input type="file" id="productImages" name="productImages" accept="image/*" multiple class="file-input">
                    <label for="productImages" class="file-upload-label">
                        <div class="upload-content">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                            <h4>Tải lên hình ảnh</h4>
                            <p>Kéo thả hoặc click để chọn ảnh</p>
                            <small>JPG, PNG, GIF - Tối đa 5MB mỗi ảnh</small>
                        </div>
                    </label>
                    <div class="image-preview-container" id="imagePreview"></div>
                </div>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions" data-aos="fade-up" data-aos-delay="400">
            <button type="submit" class="btn btn-primary btn-large">
                <i class="fa-solid fa-paper-plane"></i>
                Đăng sản phẩm
            </button>
            <a href="@Url.Action("MyProducts", "Product")" class="btn btn-secondary btn-large">
                <i class="fa-solid fa-arrow-left"></i>
                Quay lại
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Toggle affiliate settings
            $('#affiliateEnabled').change(function() {
                const isChecked = $(this).is(':checked');
                $('#affiliateSettings').toggle(isChecked);
                
                if (!isChecked) {
                    $('#AffiliateCommissionRate').val('');
                }
            });

            // Toggle price field based on posting type
            $('#postingType').change(function() {
                const postingType = $(this).val();
                const priceGroup = $('#priceGroup');
                
                if (postingType === 'Exchange' || postingType === 'Donate') {
                    priceGroup.hide();
                    $('#Price').val('0');
                } else {
                    priceGroup.show();
                }
            });

            // Image upload preview
            $('#productImages').change(function(e) {
                const files = e.target.files;
                const previewContainer = $('#imagePreview');
                previewContainer.empty();

                if (files.length > 5) {
                    alert('Chỉ được tải lên tối đa 5 hình ảnh');
                    return;
                }

                for (let i = 0; i < Math.min(files.length, 5); i++) {
                    const file = files[i];
                    
                    if (file.size > 5 * 1024 * 1024) {
                        alert(`File ${file.name} quá lớn. Kích thước tối đa 5MB.`);
                        continue;
                    }

                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const imagePreview = $(`
                            <div class="image-preview-item">
                                <img src="${e.target.result}" alt="Preview">
                                <button type="button" class="remove-image" onclick="removeImage(this)">
                                    <i class="fa-solid fa-times"></i>
                                </button>
                                ${i === 0 ? '<span class="primary-badge">Ảnh chính</span>' : ''}
                            </div>
                        `);
                        previewContainer.append(imagePreview);
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Form validation
            $('form').submit(function(e) {
                let isValid = true;
                
                // Validate required fields
                const requiredFields = ['CategoryID', 'ProductName', 'Description'];
                requiredFields.forEach(function(field) {
                    const value = $(`#${field}`).val();
                    if (!value || value.trim() === '') {
                        isValid = false;
                        showFieldError(field, 'Trường này là bắt buộc');
                    }
                });

                // Validate price for sell type
                const postingType = $('#postingType').val();
                if (postingType === 'Sell') {
                    const price = parseFloat($('#Price').val());
                    if (!price || price <= 0) {
                        isValid = false;
                        showFieldError('Price', 'Vui lòng nhập giá bán hợp lệ');
                    }
                }

                // Validate affiliate commission rate
                const isAffiliateEnabled = $('#affiliateEnabled').is(':checked');
                if (isAffiliateEnabled) {
                    const commissionRate = parseFloat($('#AffiliateCommissionRate').val());
                    if (!commissionRate || commissionRate < 0.1 || commissionRate > 50) {
                        isValid = false;
                        showFieldError('AffiliateCommissionRate', 'Tỷ lệ hoa hồng phải từ 0.1% đến 50%');
                    }
                }

                if (!isValid) {
                    e.preventDefault();
                }
            });

            function showFieldError(fieldId, message) {
                const field = $(`#${fieldId}`);
                field.addClass('error');
                field.next('.error-message').remove();
                field.after(`<span class="error-message">${message}</span>`);
            }

            // Initial setup
            $('#postingType').trigger('change');
        });

        function removeImage(button) {
            $(button).closest('.image-preview-item').remove();
        }
    </script>
}

@section Styles {
    <style>
        .create-product-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        .create-product-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .create-product-header h1 {
            color: #1f2937;
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .create-product-header p {
            color: #6b7280;
            font-size: 1.1rem;
        }

        .form-sections {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .form-section {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .form-section h2 {
            color: #1f2937;
            margin-bottom: 15px;
            font-size: 1.4rem;
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 10px;
        }

        .section-description {
            color: #6b7280;
            margin-bottom: 25px;
            font-size: 0.95rem;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: #374151;
            margin-bottom: 8px;
        }

        .form-input,
        .form-select,
        .form-textarea {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

        .form-input:focus,
        .form-select:focus,
        .form-textarea:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .input-group {
            display: flex;
            align-items: center;
        }

        .input-addon {
            background: #f3f4f6;
            border: 2px solid #e5e7eb;
            border-left: none;
            padding: 12px 16px;
            border-radius: 0 8px 8px 0;
            color: #6b7280;
            font-weight: 500;
        }

        .input-group .form-input {
            border-radius: 8px 0 0 8px;
        }

        .checkbox-group {
            margin-bottom: 0;
        }

        .checkbox-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .checkbox-input {
            transform: scale(1.2);
        }

        .checkbox-label {
            font-weight: 500;
            color: #374151;
            cursor: pointer;
        }

        .affiliate-settings {
            margin-top: 25px;
            padding: 20px;
            background: #f0f9ff;
            border-radius: 10px;
            border: 1px solid #bae6fd;
        }

        .affiliate-benefits {
            margin-top: 20px;
        }

        .affiliate-benefits h4 {
            color: #1e40af;
            margin-bottom: 10px;
        }

        .affiliate-benefits ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .affiliate-benefits li {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 5px;
            color: #1e40af;
        }

        .affiliate-benefits i {
            color: #10b981;
        }

        .help-text {
            display: block;
            margin-top: 5px;
            color: #6b7280;
            font-size: 0.85rem;
        }

        .image-upload-area {
            text-align: center;
        }

        .file-input {
            display: none;
        }

        .file-upload-label {
            display: block;
            padding: 40px;
            border: 2px dashed #d1d5db;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 20px;
        }

        .file-upload-label:hover {
            border-color: #3b82f6;
            background: #f0f9ff;
        }

        .upload-content i {
            font-size: 3rem;
            color: #9ca3af;
            margin-bottom: 15px;
        }

        .upload-content h4 {
            color: #374151;
            margin-bottom: 5px;
        }

        .upload-content p {
            color: #6b7280;
            margin-bottom: 10px;
        }

        .image-preview-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 15px;
        }

        .image-preview-item {
            position: relative;
            aspect-ratio: 1;
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid #e5e7eb;
        }

        .image-preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .remove-image {
            position: absolute;
            top: 5px;
            right: 5px;
            background: rgba(239, 68, 68, 0.9);
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 0.8rem;
        }

        .primary-badge {
            position: absolute;
            bottom: 5px;
            left: 5px;
            background: rgba(59, 130, 246, 0.9);
            color: white;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .form-actions {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 40px;
        }

        .btn-large {
            padding: 15px 40px;
            font-size: 1.1rem;
            border-radius: 10px;
            font-weight: 600;
            min-width: 180px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
            border: none;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(59, 130, 246, 0.4);
        }

        .btn-secondary {
            background: #6b7280;
            color: white;
            text-decoration: none;
        }

        .btn-secondary:hover {
            background: #4b5563;
            transform: translateY(-2px);
            text-decoration: none;
            color: white;
        }

        .error-message {
            color: #ef4444;
            font-size: 0.85rem;
            margin-top: 5px;
            display: block;
        }

        .form-input.error,
        .form-select.error,
        .form-textarea.error {
            border-color: #ef4444;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .create-product-container {
                padding: 10px;
            }

            .create-product-header h1 {
                font-size: 2rem;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .form-actions {
                flex-direction: column;
                align-items: center;
            }

            .btn-large {
                width: 100%;
                max-width: 300px;
            }
        }
    </style>
}


@model B_M.Models.Entities.Product

@{
    ViewBag.Title = Model.Name;
    Func<string, string> FormatPrice = (price) =>
    {
        if (string.IsNullOrEmpty(price)) return "0₫";
        var clean = System.Text.RegularExpressions.Regex.Replace(price, @"[^\d.]", "");
        decimal val; if (decimal.TryParse(clean, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out val))
            return val.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + "₫";
        return price + "₫";
    };
}

<div class="container" style="max-width: 1200px; margin: 0 auto; padding: 24px;">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card" style="border-radius: 12px; overflow: hidden;">
                <div class="card-body" style="padding: 16px;">
                    <div id="mainImageWrapper" style="height: 420px; background: #f8f9fa; display: flex; align-items: center; justify-content: center; border-radius: 8px; overflow: hidden;">
                        <img id="mainImage" src="@Url.Content((Model.ImageUrls != null && Model.ImageUrls.Any()) ? Model.ImageUrls.First() : "~/images/No_Image_Available.png")" alt="@Model.Name" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                    </div>
                </div>
            </div>

            <div class="product-price">
                @if (Model.PostingType == "Sell")
                {
                    <span class="price">@Model.Price.ToString("N0") ₫</span>
                }
                else if (Model.PostingType == "Exchange")
                {
                    <span class="exchange-label">Trao đổi</span>
                }
                else
                {
                    <span class="donate-label">Cho tặng miễn phí</span>
                }
            </div>

            <div class="product-stats">
                <div class="stat-item">
                    <span class="label">Tình trạng:</span>
                    <span class="value">@Model.ProductCondition</span>
                </div>
                <div class="stat-item">
                    <span class="label">Địa điểm:</span>
                    <span class="value">@Model.Location</span>
                </div>
                <div class="stat-item">
                    <span class="label">Số lượng:</span>
                    <span class="value">@Model.Quantity</span>
                </div>
            </div>

            <p class="short-description">@Html.Raw(Html.Encode(Model.Description).Replace("\n", "<br />"))</p>

            @if (ViewBag.IsOwner == true)
            {
                <div class="owner-actions">
                    <a href="@Url.Action("Edit", "Product", new { id = Model.ProductID })" class="cta-button primary">
                        <i class="fa-solid fa-edit"></i> Chỉnh sửa sản phẩm
                    </a>
                </div>
            }
            else
            {
                <div class="action-buttons">
                    @if (Model.PostingType == "Sell" && Model.Quantity > 0)
                    {
                        <div class="cart-section">
                            @using (Html.BeginForm("Add", "Cart", FormMethod.Post, new { @class = "add-to-cart-form" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("ProductID", Model.ProductID)
                                
                                <div class="quantity-selector">
                                    <label for="quantity">Số lượng:</label>
                                    <div class="quantity-control">
                                        <button type="button" class="quantity-btn minus-btn" onclick="changeQuantity(-1)">
                                            <i class="fa-solid fa-minus"></i>
                                        </button>
                                        <input type="number" id="quantity" name="Quantity" value="1" min="1" max="@Model.Quantity" class="quantity-input" />
                                        <button type="button" class="quantity-btn plus-btn" onclick="changeQuantity(1)">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                    </div>
                                    <small class="stock-info">Còn @Model.Quantity sản phẩm</small>
                                </div>

                                <button type="submit" class="cta-button primary add-to-cart-btn">
                                    <i class="fa-solid fa-shopping-cart"></i> Thêm vào giỏ hàng
                                </button>
                            }
                        </div>
                    }

                    <a href="#" class="cta-button secondary message-seller-btn open-chat-modal" 
                       data-chat-userid="@Model.UserID"
                       data-chat-username="@(Model.User?.UserDetails?.FullName ?? Model.User?.Email ?? "Người bán")"
                       data-chat-useravatar="@(Model.User?.UserDetails?.ProfilePictureURL ?? "/images/avatar-default.jpg")"
                       data-chat-postid="@Model.ProductID"
                       data-chat-posttitle="@Model.ProductName"
                       data-chat-posttype="product">
                        <i class="fa-regular fa-comments"></i> Nhắn tin cho người bán
                    </a>

                    @if (Model.PostingType == "Exchange" || Model.PostingType == "Sell")
                    {
                        <button class="cta-button tertiary exchange-btn" onclick="proposeBarter()">
                            <i class="fa-solid fa-retweet"></i> Đề nghị trao đổi
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="product-long-details" data-aos="fade-up">
        <div class="tab-links">
            <button class="tab-link active" onclick="openTab(event, 'Description')">Mô tả chi tiết</button>
            <button class="tab-link" onclick="openTab(event, 'SellerInfo')">Thông tin người bán</button>
        </div>

        <div id="Description" class="tab-content" style="display: block;">
            <h3>Chi tiết sản phẩm</h3>
            <div class="description-content">
                @Html.Raw(Html.Encode(Model.Description).Replace("\n", "<br />"))
            </div>
            
            <div class="product-details-grid">
                <div class="detail-item">
                    <span class="detail-label">Tình trạng:</span>
                    <span class="detail-value">@Model.ProductCondition</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Địa điểm:</span>
                    <span class="detail-value">@Model.Location</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Loại bài đăng:</span>
                    <span class="detail-value">
                        @switch (Model.PostingType)
                    <div class="row g-2" style="margin-top: 10px;">
                        @foreach (var img in Model.ImageUrls.Take(6))
                        {
                            <div class="col-2">
                                <img class="thumb" src="@Url.Content(img)" alt="thumb" style="width: 100%; height: 70px; object-fit: cover; border-radius: 6px; cursor: pointer; border: 2px solid transparent;" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card" style="border-radius: 12px; overflow: hidden;">
                <div class="card-body">
                    <h3 style="margin-bottom: 8px;">@Model.Name</h3>
                    <div style="color: #6b7280; margin-bottom: 8px;">
                        <i class="fa-solid fa-store"></i> Nhãn hàng: <strong>@(Model.Brand != null ? Model.Brand.BrandName : "")</strong>
                    </div>
                    <div style="color: #6b7280; margin-bottom: 16px;">
                        <i class="fa-solid fa-tag"></i> Danh mục: <strong>@Model.Category</strong>
                    </div>
                    <div style="font-size: 28px; font-weight: 800; color: #d63384; margin-bottom: 16px;">
                        @FormatPrice(Model.Price)
                    </div>
                    <div style="margin-bottom: 16px; color: #64748b;">
                        @Model.ShortDescription
                    </div>

                    <div class="input-group" style="width: 200px; margin-bottom: 12px;">
                        <span class="input-group-text">Số lượng</span>
                        <input id="qty" type="number" class="form-control" value="1" min="1" />
                    </div>

                    <button id="btnAddToCart" class="btn btn-primary" style="background: linear-gradient(135deg, #d63384, #e91e63); border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700;">
                        <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ hàng
                    </button>
                </div>
            </div>

            <div class="card" style="border-radius: 12px; overflow: hidden; margin-top: 16px;">
                <div class="card-body">
                    <h5>Thông tin người bán</h5>
                    <div style="color: #6b7280;">@Model.SellerName</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="border-radius: 12px; overflow: hidden; margin-top: 24px;">
        <div class="card-body">
            <h5>Mô tả chi tiết</h5>
            <div>@Html.Raw(Model.DetailedDescription)</div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var main = document.getElementById('mainImage');
    var thumbs = document.querySelectorAll('.thumb');
    thumbs.forEach(function (t) {
        t.addEventListener('click', function () {
            main.src = this.src;
            thumbs.forEach(x => x.style.borderColor = 'transparent');
            this.style.borderColor = '#d63384';
        });
    });

    document.getElementById('btnAddToCart').addEventListener('click', function () {
        var qty = parseInt(document.getElementById('qty').value || '1');
        $.post('@Url.Action("AddToCart", "Product")', { productId: @Model.Id, quantity: qty })
            .done(function (res) {
                if (res && res.loginRequired) {
                    window.location.href = res.loginUrl + '?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                } else if (res && res.success) {
                    window.location.href = '@Url.Action("Cart", "Product")';
                } else {
                    alert(res && res.message ? res.message : 'Không thể thêm vào giỏ hàng');
                }
            });
    });
});
</script>

 
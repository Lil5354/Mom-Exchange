@model B_M.Models.Entities.Product

@{
    ViewBag.Title = Model.Name;
    Func<string, string> FormatPrice = (price) =>
    {
        if (string.IsNullOrEmpty(price)) return "0₫";
        var clean = System.Text.RegularExpressions.Regex.Replace(price, @"[^\d.]", "");
        decimal val; if (decimal.TryParse(clean, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out val))
            return val.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + "₫";
        return price + "₫";
    };
}

<div class="container" style="max-width: 1200px; margin: 0 auto; padding: 24px;">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card" style="border-radius: 12px; overflow: hidden;">
                <div class="card-body" style="padding: 16px;">
                    <div id="mainImageWrapper" style="height: 420px; background: #f8f9fa; display: flex; align-items: center; justify-content: center; border-radius: 8px; overflow: hidden;">
                        <img id="mainImage" src="@Url.Content((Model.ImageUrls != null && Model.ImageUrls.Any()) ? Model.ImageUrls.First() : "~/images/No_Image_Available.png")" alt="@Model.Name" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                    </div>
                    <div class="row g-2" style="margin-top: 10px;">
                        @foreach (var img in Model.ImageUrls.Take(6))
                        {
                            <div class="col-2">
                                <img class="thumb" src="@Url.Content(img)" alt="thumb" style="width: 100%; height: 70px; object-fit: cover; border-radius: 6px; cursor: pointer; border: 2px solid transparent;" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card" style="border-radius: 12px; overflow: hidden;">
                <div class="card-body">
                    <h3 style="margin-bottom: 8px;">@Model.Name</h3>
                    <div style="color: #6b7280; margin-bottom: 8px;">
                        <i class="fa-solid fa-store"></i> Nhãn hàng: <strong>@(Model.Brand != null ? Model.Brand.BrandName : "")</strong>
                    </div>
                    <div style="color: #6b7280; margin-bottom: 16px;">
                        <i class="fa-solid fa-tag"></i> Danh mục: <strong>@Model.Category</strong>
                    </div>
                    <div style="font-size: 28px; font-weight: 800; color: #d63384; margin-bottom: 16px;">
                        @FormatPrice(Model.Price)
                    </div>
                    <div style="margin-bottom: 16px; color: #64748b;">
                        @Model.ShortDescription
                    </div>

                    <div class="input-group" style="width: 200px; margin-bottom: 12px;">
                        <span class="input-group-text">Số lượng</span>
                        <input id="qty" type="number" class="form-control" value="1" min="1" />
                    </div>

                    <button id="btnAddToCart" class="btn btn-primary" style="background: linear-gradient(135deg, #d63384, #e91e63); border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700;">
                        <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ hàng
                    </button>
                </div>
            </div>

            <div class="card" style="border-radius: 12px; overflow: hidden; margin-top: 16px;">
                <div class="card-body">
                    <h5>Thông tin người bán</h5>
                    <div style="color: #6b7280;">@Model.SellerName</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="border-radius: 12px; overflow: hidden; margin-top: 24px;">
        <div class="card-body">
            <h5>Mô tả chi tiết</h5>
            <div>@Html.Raw(Model.DetailedDescription)</div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var main = document.getElementById('mainImage');
    var thumbs = document.querySelectorAll('.thumb');
    thumbs.forEach(function (t) {
        t.addEventListener('click', function () {
            main.src = this.src;
            thumbs.forEach(x => x.style.borderColor = 'transparent');
            this.style.borderColor = '#d63384';
        });
    });

    document.getElementById('btnAddToCart').addEventListener('click', function () {
        var qty = parseInt(document.getElementById('qty').value || '1');
        $.post('@Url.Action("AddToCart", "Product")', { productId: @Model.Id, quantity: qty })
            .done(function (res) {
                if (res && res.loginRequired) {
                    window.location.href = res.loginUrl + '?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                } else if (res && res.success) {
                    window.location.href = '@Url.Action("Cart", "Product")';
                } else {
                    alert(res && res.message ? res.message : 'Không thể thêm vào giỏ hàng');
                }
            });
    });
});
</script>

 
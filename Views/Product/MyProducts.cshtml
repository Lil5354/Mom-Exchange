@model B_M.Models.MyProductsViewModel

@{
    ViewBag.Title = "Quản lý sản phẩm của tôi";
}

<div class="my-products-container">
    <div class="my-products-header" data-aos="fade-up">
        <h1><i class="fa-solid fa-boxes-stacked"></i> Sản phẩm của tôi</h1>
        <div class="header-actions">
            <a href="@Url.Action("Create", "Product")" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Đăng sản phẩm mới
            </a>
        </div>
    </div>

    <!-- Statistics -->
    <div class="stats-grid" data-aos="fade-up" data-aos-delay="100">
        <div class="stat-card pending">
            <div class="stat-number">@Model.PendingCount</div>
            <div class="stat-label">Chờ duyệt</div>
        </div>
        <div class="stat-card approved">
            <div class="stat-number">@Model.ApprovedCount</div>
            <div class="stat-label">Đã duyệt</div>
        </div>
        <div class="stat-card rejected">
            <div class="stat-number">@Model.RejectedCount</div>
            <div class="stat-label">Bị từ chối</div>
        </div>
        <div class="stat-card total">
            <div class="stat-number">@Model.Products.Count</div>
            <div class="stat-label">Tổng cộng</div>
        </div>
    </div>

    <!-- Products List -->
    <div class="products-section" data-aos="fade-up" data-aos-delay="200">
        @if (Model.Products.Any())
        {
            <div class="products-grid">
                @foreach (var product in Model.Products)
                {
                    <div class="product-card @product.StatusClass" data-aos="fade-up" data-aos-delay="@((Model.Products.IndexOf(product) % 3) * 100)">
                        <div class="product-image">
                            <img src="@product.PrimaryImageUrl" alt="@product.ProductName" />
                            <div class="product-status">
                                <span class="status-badge @product.StatusClass">@product.StatusText</span>
                            </div>
                            @if (product.IsAffiliateEnabled)
                            {
                                <div class="affiliate-badge">
                                    <i class="fa-solid fa-handshake"></i>
                                    Affiliate @product.AffiliateCommissionRate%
                                </div>
                            }
                        </div>
                        
                        <div class="product-info">
                            <h3 class="product-name">@product.ProductName</h3>
                            <p class="product-price">@product.FormattedPrice</p>
                            <p class="product-condition">@product.ProductCondition</p>
                            <p class="product-location"><i class="fa-solid fa-location-dot"></i> @product.Location</p>
                            <p class="product-date"><i class="fa-solid fa-calendar"></i> @product.CreatedAt.ToString("dd/MM/yyyy")</p>
                        </div>

                        <div class="product-actions">
                            @if (product.Status == "Approved")
                            {
                                <a href="@Url.Action("Details", "Product", new { id = product.ProductID })" class="btn btn-outline">
                                    <i class="fa-solid fa-eye"></i> Xem
                                </a>
                            }
                            <a href="@Url.Action("Edit", "Product", new { id = product.ProductID })" class="btn btn-outline">
                                <i class="fa-solid fa-edit"></i> Sửa
                            </a>
                            <button type="button" class="btn btn-danger btn-delete" data-id="@product.ProductID">
                                <i class="fa-solid fa-trash"></i> Xóa
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fa-solid fa-box-open"></i>
                </div>
                <h3>Chưa có sản phẩm nào</h3>
                <p>Bạn chưa đăng sản phẩm nào. Hãy đăng sản phẩm đầu tiên để bắt đầu bán hàng!</p>
                <a href="@Url.Action("Create", "Product")" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> Đăng sản phẩm đầu tiên
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Delete product functionality
            $('.btn-delete').on('click', function() {
                const productId = $(this).data('id');
                const productCard = $(this).closest('.product-card');
                
                if (confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Product")',
                        type: 'POST',
                        data: { 
                            id: productId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                productCard.fadeOut(300, function() {
                                    $(this).remove();
                                    // Update stats if needed
                                    updateStats();
                                });
                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        },
                        error: function() {
                            showNotification('Có lỗi xảy ra khi xóa sản phẩm.', 'error');
                        }
                    });
                }
            });
            
            function updateStats() {
                // Recalculate and update statistics
                const totalProducts = $('.product-card').length;
                const pendingCount = $('.product-card.status-pending').length;
                const approvedCount = $('.product-card.status-approved').length;
                const rejectedCount = $('.product-card.status-rejected').length;
                
                $('.stat-card.total .stat-number').text(totalProducts);
                $('.stat-card.pending .stat-number').text(pendingCount);
                $('.stat-card.approved .stat-number').text(approvedCount);
                $('.stat-card.rejected .stat-number').text(rejectedCount);
            }
            
            function showNotification(message, type) {
                // You can implement a toast notification here
                alert(message);
            }
        });
    </script>
}

@section Styles {
    <style>
        .my-products-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .my-products-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .my-products-header h1 {
            color: #1f2937;
            margin: 0;
            font-size: 2.2rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            border-left: 4px solid;
        }

        .stat-card.pending {
            border-left-color: #f59e0b;
        }

        .stat-card.approved {
            border-left-color: #10b981;
        }

        .stat-card.rejected {
            border-left-color: #ef4444;
        }

        .stat-card.total {
            border-left-color: #3b82f6;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .stat-card.pending .stat-number {
            color: #f59e0b;
        }

        .stat-card.approved .stat-number {
            color: #10b981;
        }

        .stat-card.rejected .stat-number {
            color: #ef4444;
        }

        .stat-card.total .stat-number {
            color: #3b82f6;
        }

        .stat-label {
            color: #6b7280;
            font-weight: 500;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
        }

        .product-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            border: 1px solid #e5e7eb;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .product-image {
            position: relative;
            height: 200px;
            overflow: hidden;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .product-card:hover .product-image img {
            transform: scale(1.05);
        }

        .product-status {
            position: absolute;
            top: 10px;
            right: 10px;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
            color: white;
        }

        .status-badge.status-pending {
            background: #f59e0b;
        }

        .status-badge.status-approved {
            background: #10b981;
        }

        .status-badge.status-rejected {
            background: #ef4444;
        }

        .status-badge.status-hidden {
            background: #6b7280;
        }

        .affiliate-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 5px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .product-info {
            padding: 20px;
        }

        .product-name {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1f2937;
            margin: 0 0 10px 0;
            line-height: 1.3;
        }

        .product-price {
            font-size: 1.2rem;
            font-weight: 700;
            color: #059669;
            margin: 0 0 8px 0;
        }

        .product-condition,
        .product-location,
        .product-date {
            font-size: 0.9rem;
            color: #6b7280;
            margin: 0 0 5px 0;
        }

        .product-location i,
        .product-date i {
            margin-right: 5px;
            color: #9ca3af;
        }

        .product-actions {
            padding: 15px 20px;
            background: #f9fafb;
            display: flex;
            gap: 8px;
        }

        .btn {
            padding: 8px 15px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-primary {
            background: linear-gradient(135d, #3b82f6 0%, #1d4ed8 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
            text-decoration: none;
            color: white;
        }

        .btn-outline {
            background: white;
            border: 1px solid #d1d5db;
            color: #374151;
        }

        .btn-outline:hover {
            background: #f3f4f6;
            border-color: #9ca3af;
            text-decoration: none;
            color: #374151;
        }

        .btn-danger {
            background: #ef4444;
            color: white;
        }

        .btn-danger:hover {
            background: #dc2626;
            transform: translateY(-1px);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .empty-icon {
            font-size: 4rem;
            color: #d1d5db;
            margin-bottom: 20px;
        }

        .empty-state h3 {
            color: #374151;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #6b7280;
            margin-bottom: 25px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .my-products-header {
                flex-direction: column;
                gap: 15px;
            }

            .my-products-header h1 {
                font-size: 1.8rem;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .products-grid {
                grid-template-columns: 1fr;
            }

            .product-actions {
                flex-direction: column;
            }

            .btn {
                justify-content: center;
            }
        }
    </style>
}

@Html.AntiForgeryToken()


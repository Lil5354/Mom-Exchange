@using B_M.Models.Entities
@using B_M.Helpers
@model List<B_M.Models.Entities.Order>
@{
    ViewBag.Title = "Xác nhận đặt hàng";
    var paymentLinks = ViewBag.PaymentLinks as Dictionary<string, PayOSPaymentLink> ?? new Dictionary<string, PayOSPaymentLink>();
}

<div class="container" style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
    <div class="success-message" style="text-align: center; padding: 40px; background: linear-gradient(135deg, #d4edda, #c3e6cb); border-radius: 15px; margin-bottom: 30px;">
        <i class="fa-solid fa-check-circle" style="font-size: 80px; color: #28a745; margin-bottom: 20px;"></i>
        <h2 style="color: #155724; margin-bottom: 10px;">Đặt hàng thành công!</h2>
        <p style="color: #155724; font-size: 16px;">Vui lòng quét mã QR để thanh toán</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="order-info-card" style="background: white; padding: 30px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin-bottom: 30px;">
            <h3 style="margin-bottom: 20px; color: #d63384;">
                <i class="fa-solid fa-info-circle"></i> Thông tin đơn hàng
            </h3>

            @foreach (var order in Model)
            {
                <div style="border: 2px solid #d63384; border-radius: 10px; padding: 20px; margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <div>
                            <h4 style="margin: 0; color: #333;">Mã đơn hàng: <strong style="color: #d63384;">@order.OrderCode</strong></h4>
                            <p style="margin: 5px 0 0 0; color: #666; font-size: 14px;">Ngày đặt: @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <span class="badge badge-warning" style="padding: 8px 15px; font-size: 14px;">Chờ thanh toán</span>
                    </div>

                    <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                            <span>Tổng tiền hàng:</span>
                            <span><strong>@order.SubTotal.ToString("N0")₫</strong></span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                            <span>Phí hoa hồng (5%):</span>
                            <span>@order.Commission.ToString("N0")₫</span>
                        </div>
                        <div style="border-top: 2px solid #ddd; padding-top: 10px; margin-top: 10px;">
                            <div style="display: flex; justify-content: space-between; font-size: 18px; font-weight: bold; color: #d63384;">
                                <span>Tổng thanh toán:</span>
                                <span>@order.TotalAmount.ToString("N0")₫</span>
                            </div>
                        </div>
                    </div>

                    @if (paymentLinks.ContainsKey(order.OrderCode))
                    {
                        var payOSLink = paymentLinks[order.OrderCode];
                        
                        <div style="display: block; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                            <!-- Left: QR Code -->
                            <div style="background: white; padding: 30px; border-radius: 12px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                                <div style="margin-bottom: 15px;">
                                    <span style="color: #dc2626; font-weight: bold; font-size: 18px;">VIETQR</span>
                                    <span style="color: #10b981; font-weight: bold; font-size: 18px;"> PRO</span>
                                </div>

                                @{
                                    string qrImageUrl = null;
                                    if (!string.IsNullOrEmpty(payOSLink.QrCode))
                                    {
                                        // Check if it's already an image URL or VietQR text
                                        if (payOSLink.QrCode.StartsWith("data:image") || payOSLink.QrCode.StartsWith("http"))
                                        {
                                            qrImageUrl = payOSLink.QrCode;
                                        }
                                        else
                                        {
                                            // Generate QR code image from VietQR text
                                            qrImageUrl = QRCodeHelper.GenerateQRCodeImageUrl(payOSLink.QrCode);
                                        }
                                    }
                                }

                                @if (!string.IsNullOrEmpty(qrImageUrl))
                                {
                                    <div id="qr-code-container-@order.OrderCode" style="margin: 20px 0;">
                                        <img id="qr-img-@order.OrderCode" src="@qrImageUrl" alt="QR Code" style="max-width: 100%; border: 4px solid white; box-shadow: 0 4px 15px rgba(0,0,0,0.1);" />
                                    </div>
                                }
                                else
                                {
                                    <div id="qr-code-container-@order.OrderCode" style="margin: 20px auto; width: 250px; height: 250px; background: #f3f4f6; display: flex; align-items: center; justify-content: center;">
                                        <p style="color: #6b7280;">Đang tạo mã QR...</p>
                                    </div>
                                }

                                <div style="display: flex; justify-content: center; gap: 10px; margin-top: 15px;">
                                    <img src="@Url.Content("/images/Logo_MB_new.png")" alt="MB" style="height: 30px;" />
                                </div>

                                <div style="text-align: center; margin-top: 20px;">
                                    <a href="@payOSLink.CheckoutUrl" target="_blank" class="btn btn-primary" style="padding: 12px 40px; border-radius: 25px; text-decoration: none; font-weight: bold; display: inline-block; background: linear-gradient(135deg, #d63384, #e91e63);">
                                        <i class="fa-solid fa-external-link"></i> Thanh toán trực tuyến
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="background: #fff3cd; padding: 15px; border-radius: 8px; border-left: 4px solid #ffc107;">
                            <strong style="color: #856404;">
                                <i class="fa-solid fa-exclamation-triangle"></i> Hướng dẫn thanh toán:
                            </strong>
                            <ol style="margin: 10px 0 0 20px; color: #856404;">
                                <li>Chuyển khoản số tiền <strong>@order.TotalAmount.ToString("N0")₫</strong></li>
                                <li>Nội dung chuyển khoản: <strong>@order.OrderCode</strong></li>
                                <li>Đơn hàng sẽ được xác nhận sau khi thanh toán thành công</li>
                            </ol>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="next-steps" style="text-align: center;">
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary" style="padding: 15px 40px; border-radius: 25px; font-weight: bold; text-decoration: none; display: inline-block; margin-right: 10px;">
                <i class="fa-solid fa-home"></i> Về trang chủ
            </a>
            <a href="@Url.Action("Index", "OrderUser")" class="btn btn-outline-primary" style="padding: 15px 40px; border-radius: 25px; font-weight: bold; text-decoration: none; display: inline-block;">
                <i class="fa-solid fa-list"></i> Xem đơn hàng của tôi
            </a>
        </div>
    }
</div>

<style>
    .btn {
        background: linear-gradient(135deg, #d63384, #e91e63);
        color: white;
        border: none;
        transition: all 0.3s ease;
    }
    
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(214, 51, 132, 0.4);
    }
    
    .btn-outline-primary {
        background: white;
        border: 2px solid #d63384;
        color: #d63384;
    }
    
    .btn-outline-primary:hover {
        background: #d63384;
        color: white;
    }
    
    #copySuccessMessage {
        position: fixed;
        top: 20px;
        right: 20px;
        background: #10b981;
        color: white;
        padding: 12px 24px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        z-index: 9999;
        display: none;
    }
</style>

<script>
function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(function() {
        showCopySuccess();
    }, function(err) {
        // Fallback for older browsers
        var textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.style.position = "fixed";
        textArea.style.top = "0";
        textArea.style.left = "0";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
            document.execCommand('copy');
            showCopySuccess();
        } catch (err) {
            alert('Could not copy text');
        }
        document.body.removeChild(textArea);
    });
}

function showCopySuccess() {
    var msg = document.getElementById('copySuccessMessage');
    if (msg) {
        msg.style.display = 'block';
        setTimeout(function() {
            msg.style.display = 'none';
        }, 2000);
    }
}
</script>

<div id="copySuccessMessage">
    <i class="fa-solid fa-check-circle"></i> Đã sao chép!
</div>


@model B_M.Models.MilkDonationStatusViewModel

@{
    ViewBag.Title = "Quản lý trạng thái tặng sữa mẹ";
}

<div class="milk-donation-container">
    <div class="milk-donation-header" data-aos="fade-up">
        <h1><i class="fa-solid fa-heart"></i> Hệ thống tặng sữa mẹ 2 tầng</h1>
        <p>Xác minh sức khỏe để tham gia chương trình tặng sữa mẹ an toàn</p>
    </div>

    <!-- Current Status -->
    <div class="current-status-card" data-aos="fade-up" data-aos-delay="100">
        <h2>Trạng thái hiện tại của bạn</h2>
        <div class="status-display">
            <div class="status-badge status-@Model.MilkDonationStatus">
                <i class="fa-solid fa-shield-heart"></i>
                <span>@Model.StatusText</span>
            </div>
        </div>
    </div>

    <!-- Verification Process -->
    <div class="verification-process" data-aos="fade-up" data-aos-delay="200">
        <h2>Quy trình xác minh</h2>
        
        <div class="tiers-grid">
            <!-- Tier 1 -->
            <div class="tier-card tier-1 @(Model.MilkDonationStatus >= 1 ? "active" : "") @(Model.MilkDonationStatus >= 1 ? "completed" : "")">
                <div class="tier-header">
                    <div class="tier-icon">
                        @if (Model.MilkDonationStatus >= 1)
                        {
                            <i class="fa-solid fa-check-circle"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-clipboard-list"></i>
                        }
                    </div>
                    <div class="tier-info">
                        <h3>Tầng 1 - Khai báo Cơ bản</h3>
                        <p>Hoàn thành khảo sát lối sống để bắt đầu cho tặng</p>
                    </div>
                </div>
                
                <div class="tier-requirements">
                    <h4>Yêu cầu:</h4>
                    <ul>
                        <li class="@(Model.HasLifestyleSurvey ? "completed" : "")">
                            <i class="fa-solid fa-@(Model.HasLifestyleSurvey ? "check" : "circle")"></i>
                            Hoàn thành khảo sát lối sống
                        </li>
                    </ul>
                </div>

                @if (Model.MilkDonationStatus == 0)
                {
                    <div class="tier-actions">
                        <button onclick="openLifestyleSurveyModal()" class="btn btn-primary">
                            <i class="fa-solid fa-clipboard-list"></i> Bắt đầu Tầng 1
                        </button>
                    </div>
                }
                else if (Model.MilkDonationStatus >= 1)
                {
                    <div class="tier-status">
                        <span class="status-completed">
                            <i class="fa-solid fa-check-circle"></i> Đã hoàn thành Tầng 1
                        </span>
                    </div>
                }
            </div>

            <!-- Tier 2 -->
            <div class="tier-card tier-2 @(Model.MilkDonationStatus >= 3 ? "completed" : "") @(Model.MilkDonationStatus >= 1 && Model.MilkDonationStatus < 3 ? "available" : "")">
                <div class="tier-header">
                    <div class="tier-icon">
                        @if (Model.MilkDonationStatus >= 3)
                        {
                            <i class="fa-solid fa-check-circle"></i>
                        }
                        else if (Model.MilkDonationStatus >= 1)
                        {
                            <i class="fa-solid fa-file-medical"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-lock"></i>
                        }
                    </div>
                    <div class="tier-info">
                        <h3>Tầng 2 - Xác thực Y tế</h3>
                        <p>Upload hồ sơ y tế để được xác thực đầy đủ</p>
                    </div>
                </div>
                
                <div class="tier-requirements">
                    <h4>Yêu cầu:</h4>
                    <ul>
                        
                            
                        
                        <li class="@(Model.ApprovedMedicalRecordsCount > 0 ? "completed" : "")">
                            <i class="fa-solid fa-@(Model.ApprovedMedicalRecordsCount > 0 ? "check" : "circle")"></i>
                            Đã hoàn thành Tầng 1 & Cung cấp hồ sơ y tế và chờ duyệt
                        </li>
                    </ul>
                </div>

                @if (Model.MilkDonationStatus >= 1 && Model.MilkDonationStatus < 3)
                {
                    <div class="tier-actions">
                        <button onclick="openMedicalRecordsModal()" class="btn btn-premium">
                            <i class="fa-solid fa-file-medical"></i> 
                            @if (Model.MilkDonationStatus == 2)
                            {
                                <text>Quản lý hồ sơ</text>
                            }
                            else
                            {
                                <text>Nâng cấp Tầng 2</text>
                            }
                        </button>
                    </div>
                }
                else if (Model.MilkDonationStatus < 1)
                {
                    <div class="tier-status">
                        <span class="status-locked">
                            <i class="fa-solid fa-lock"></i> Cần hoàn thành Tầng 1 trước
                        </span>
                    </div>
                }
                else if (Model.MilkDonationStatus == 2)
                {
                    <div class="tier-status">
                        <span class="status-pending">
                            <i class="fa-solid fa-clock"></i> Đang chờ admin duyệt...
                        </span>
                    </div>
                }
                else if (Model.MilkDonationStatus >= 3)
                {
                    <div class="tier-status">
                        <span class="status-completed">
                            <i class="fa-solid fa-check-circle"></i> Đã xác thực y tế đầy đủ!
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Benefits -->
    <div class="benefits-section" data-aos="fade-up" data-aos-delay="300">
        <h2>Lợi ích của việc xác minh</h2>
        <div class="benefits-grid">
            <div class="benefit-card">
                <i class="fa-solid fa-handshake"></i>
                <h3>Tin cậy cao</h3>
                <p>Tăng độ tin cậy với các mẹ khác khi tặng sữa</p>
            </div>
            <div class="benefit-card">
                <i class="fa-solid fa-arrow-trend-up"></i>
                <h3>Ưu tiên hiển thị</h3>
                <p>Posts tặng sữa được hiển thị ưu tiên hàng đầu</p>
            </div>
            <div class="benefit-card">
                <i class="fa-solid fa-users"></i>
                <h3>Cộng đồng chất lượng</h3>
                <p>Kết nối với các mẹ đã được xác minh sức khỏe</p>
            </div>
            <div class="benefit-card">
                <i class="fa-solid fa-heart-pulse"></i>
                <h3>An toàn cho bé</h3>
                <p>Đảm bảo sữa mẹ an toàn và chất lượng</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/Content/milk-donation-style.css" rel="stylesheet" />
    <style>
        /* Override for compact Profile/MilkDonation layout */
        .milk-donation-container {
            max-width: 1200px !important;
            margin: 0 auto !important;
            padding: 12px !important;
        }
        
        .milk-donation-header {
            text-align: center !important;
            margin-bottom: 16px !important;
        }
        
        .milk-donation-header h1 {
            color: #e15b7f !important;
            font-size: 1.6rem !important;
            margin-bottom: 6px !important;
        }
        
        .milk-donation-header p {
            color: #666 !important;
            font-size: 0.9rem !important;
        }
        
        .current-status-card {
            background: white !important;
            border-radius: 10px !important;
            padding: 15px !important;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08) !important;
            margin-bottom: 16px !important;
            text-align: center !important;
        }
        
        .current-status-card h2 {
            margin: 0 0 10px 0 !important;
            color: #333 !important;
            font-size: 1.1rem !important;
        }
        
        .status-badge {
            display: inline-flex !important;
            align-items: center !important;
            gap: 6px !important;
            padding: 8px 16px !important;
            border-radius: 16px !important;
            font-weight: 600 !important;
            font-size: 0.85rem !important;
        }
        
        .status-badge.status-0 {
            background: #f3f4f6 !important;
            color: #6b7280 !important;
        }

        .status-badge.status-1 {
            background: #fef3c7 !important;
            color: #d97706 !important;
        }

        .status-badge.status-2 {
            background: #dbeafe !important;
            color: #2563eb !important;
        }

        .status-badge.status-3 {
            background: #d1fae5 !important;
            color: #059669 !important;
        }

        .status-badge.status-4 {
            background: #fee2e2 !important;
            color: #dc2626 !important;
        }
        
        .verification-process h2 {
            text-align: center !important;
            margin-bottom: 16px !important;
            color: #333 !important;
            font-size: 1.2rem !important;
        }
        
        .tiers-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 16px !important;
            margin-bottom: 16px !important;
        }
        
        .tier-card {
            background: white !important;
            border-radius: 10px !important;
            padding: 12px !important;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08) !important;
            border-left: 4px solid #e5e7eb !important;
            transition: all 0.3s ease !important;
            height: fit-content !important;
        }
        
        .tier-card.active {
            border-left-color: #f59e0b !important;
        }

        .tier-card.completed {
            border-left-color: #10b981 !important;
        }

        .tier-card.available {
            border-left-color: #3b82f6 !important;
        }
        
        .tier-header {
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
            margin-bottom: 12px !important;
        }
        
        .tier-icon {
            font-size: 1.3rem !important;
        }
        
        .tier-1 .tier-icon {
            color: #3b82f6 !important;
        }

        .tier-2 .tier-icon {
            color: #10b981 !important;
        }
        
        .tier-info h3 {
            margin: 0 0 3px 0 !important;
            color: #333 !important;
            font-size: 1rem !important;
        }
        
        .tier-info p {
            margin: 0 !important;
            color: #666 !important;
            font-size: 0.8rem !important;
        }
        
        .tier-requirements h4 {
            margin: 0 0 8px 0 !important;
            color: #333 !important;
            font-size: 0.9rem !important;
        }
        
        .tier-requirements ul {
            list-style: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        
        .tier-requirements li {
            display: flex !important;
            align-items: center !important;
            gap: 6px !important;
            padding: 4px 0 !important;
            color: #666 !important;
            font-size: 0.8rem !important;
        }
        
        .tier-requirements li.completed {
            color: #10b981 !important;
        }

        .tier-requirements li.completed i {
            color: #10b981 !important;
        }
        
        .tier-actions,
        .tier-status {
            margin-top: 12px !important;
            text-align: center !important;
        }
        
        .btn {
            padding: 6px 16px !important;
            border-radius: 6px !important;
            text-decoration: none !important;
            font-weight: 600 !important;
            transition: all 0.3s ease !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 4px !important;
            font-size: 0.8rem !important;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%) !important;
            color: white !important;
        }

        .btn-premium {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
            color: white !important;
        }

        .btn:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2) !important;
        }

        .status-pending {
            color: #f59e0b !important;
            font-weight: 600 !important;
        }

        .status-completed {
            color: #10b981 !important;
            font-weight: 600 !important;
        }

        .status-locked {
            color: #6b7280 !important;
            font-weight: 600 !important;
        }
        
        .benefits-section {
            margin-top: 20px !important;
        }
        
        .benefits-section h2 {
            text-align: center !important;
            margin-bottom: 16px !important;
            color: #333 !important;
            font-size: 1.2rem !important;
        }
        
        .benefits-grid {
            display: grid !important;
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 12px !important;
        }
        
        .benefit-card {
            background: white !important;
            border-radius: 10px !important;
            padding: 12px !important;
            text-align: center !important;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08) !important;
            transition: all 0.3s ease !important;
        }
        
        .benefit-card:hover {
            transform: translateY(-2px) !important;
        }
        
        .benefit-card i {
            font-size: 1.5rem !important;
            color: #e15b7f !important;
            margin-bottom: 8px !important;
        }
        
        .benefit-card h3 {
            margin: 0 0 6px 0 !important;
            color: #333 !important;
            font-size: 0.9rem !important;
        }
        
        .benefit-card p {
            margin: 0 !important;
            color: #666 !important;
            font-size: 0.7rem !important;
            line-height: 1.3 !important;
        }
        
        /* Responsive adjustments */
        @@media (max-width: 1024px) {
            .benefits-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }
        }
        
        @@media (max-width: 768px) {
            .tiers-grid {
                grid-template-columns: 1fr !important;
                gap: 15px !important;
            }
            
            .tier-header {
                flex-direction: column !important;
                text-align: center !important;
                gap: 8px !important;
            }
            
            .benefits-grid {
                grid-template-columns: 1fr !important;
            }
        }
    </style>
}

@section Scripts {
    <script>
        function openLifestyleSurveyModal() {
            // Redirect to MilkDonation page and trigger modal
            window.location.href = '@Url.Action("Index", "MilkDonation")' + '?openLifestyleSurvey=true';
        }

        function openMedicalRecordsModal() {
            // Redirect to MilkDonation page and trigger modal
            window.location.href = '@Url.Action("Index", "MilkDonation")' + '?openMedicalRecords=true';
        }
    </script>
}


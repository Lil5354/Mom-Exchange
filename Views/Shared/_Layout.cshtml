    <!-- Global Toast Notification JavaScript -->
    <script>
        // Toast Notification Functions
        function closeToast(button) {
            const toast = button.parentElement;
            toast.classList.add('removing');
            setTimeout(() => {
                toast.remove();
            }, 300);
        }

        // Auto-close toasts after 5 seconds
        document.addEventListener('DOMContentLoaded', function () {
            console.log('DOM loaded, checking for toasts...');
            const toasts = document.querySelectorAll('.toast');
            console.log('Found toasts:', toasts.length);

            toasts.forEach((toast, index) => {
                console.log(`Toast ${index}:`, toast);

                // Only ensure toast is visible, don't override animation
                toast.style.display = 'flex';
                toast.style.visibility = 'visible';

                // Trigger animation after a small delay
                setTimeout(() => {
                    toast.classList.add('toast-animate');
                }, 50);

                setTimeout(() => {
                    if (document.body.contains(toast)) {
                        const closeButton = toast.querySelector('.toast-close');
                        if (closeButton) {
                            closeToast(closeButton);
                        }
                    }
                }, 5000);
            });
        });

        // Function to create toast dynamically (for AJAX calls)
        function showToast(message, type = 'info') {
            const container = document.getElementById('globalToastContainer');
            if (!container) return;

            const icons = {
                success: '✅',
                error: '❌',
                info: 'ℹ️'
            };

            const titles = {
                success: 'Thành công!',
                error: 'Lỗi!',
                info: 'Thông báo!'
            };

            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.innerHTML = `
                        <div class="toast-icon">${icons[type]}</div>
                        <div class="toast-content">
                            <div class="toast-title">${titles[type]}</div>
                            <div class="toast-message">${message}</div>
                        </div>
                        <button class="toast-close" onclick="closeToast(this)">&times;</button>
                    `;

            container.appendChild(toast);

            // Trigger animation after a small delay
            setTimeout(() => {
                toast.classList.add('toast-animate');
            }, 50);

            // Auto-close
            setTimeout(() => {
                if (document.body.contains(toast)) {
                    const closeButton = toast.querySelector('.toast-close');
                    if (closeButton) {
                        closeToast(closeButton);
                    }
                }
            }, 5000);
        }
    </script>
